# İSTEĞE BAĞLI — konteynerin kendisi TLS sonlandıracaksa (önde ayrı bir ters vekil / yük dengeleyici yoksa).
# Kullanım (DOCKER_GUIDE.md §3.4):
#   docker run -d -p 80:80 -p 443:443 \
#     -v "$PWD/certs:/etc/nginx/certs:ro" \
#     -v "$PWD/nginx/tls.conf.example:/etc/nginx/sites/tls.conf:ro" \
#     medipol-envanter:<sürüm>
# certs/ içinde fullchain.pem ve privkey.pem beklenir (ör. Let's Encrypt). Sertifika dosyaları imaja ve git'e GİRMEZ.

server {
    listen       443 ssl;
    http2        on;
    server_name  _;

    ssl_certificate      /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key  /etc/nginx/certs/privkey.pem;
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_session_cache    shared:SSL:10m;
    ssl_session_timeout  1d;

    # $hsts_header TLS'te dolu (nginx.conf map) → Strict-Transport-Security gönderilir.
    include /etc/nginx/snippets/site.inc;
}

# HTTP isteklerini HTTPS'e yönlendirmek için sites/default.conf yerine bunu kullanın (aynı adla mount edin):
# server { listen 80; server_name _; return 301 https://$host$request_uri; }
