# =============================================================================
# .dockerignore — Antigravity Frontend
# Prevents large, unnecessary, or sensitive files from being sent to the
# Docker build context (directly impacts build speed and image size).
# =============================================================================

# Node.js dependencies (never needed in the final image)
node_modules/
package-lock.json

# Firebase tooling & emulator cache
.firebase/
firebase-debug.log*

# Environment & secrets — NEVER ship to an image
.env
.env.*

# Version control
.git/
.gitignore

# IDE and agent config directories
.agents/
.kilo/
.lingma/
.github/

# Backup and dev-only directories
backup/
scratch/
functions/

# Puppeteer debug scripts
puppeteer_debug.js

# Build & temp artifacts
*.log
*.pid
*.tgz
.npm
.eslintcache

# Documentation
*.md
Modelfile
Mimari ve Geliştirmeler/

# Firebase Firestore rules are already blocked by nginx.conf,
# but we exclude them from the image context entirely.
firestore.rules
.firebaserc

# Docker files themselves (not needed inside the container)
Dockerfile
docker-compose.yml
