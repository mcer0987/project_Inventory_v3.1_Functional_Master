{
  "scripts": {
    "emu": "firebase emulators:start --only firestore,auth --project medipol-inventory-v3",
    "emu:seed": "node scratch/emu-seed.mjs push",
    "emu:pull": "node scratch/emu-seed.mjs pull",
    "test:rules": "firebase emulators:exec --config tests/rules/firebase.rules-test.json --only firestore --project demo-rules-test \"node --test --test-reporter=spec tests/rules/*.test.mjs\"",
    "test:unit": "node --test --test-reporter=spec tests/unit/*.test.mjs",
    "smoke": "node scratch/smoke-test.js",
    "flow": "node scratch/flow-tests.js",
    "lint:xss": "node scratch/xss-lint.js",
    "lint:xss:self-test": "node scratch/xss-lint.js --self-test",
    "test:atomic:emu": "firebase emulators:exec --config tests/rules/firebase.rules-test.json --only firestore --project demo-atomic-writer \"node --test --test-reporter=spec tests/integration/atomic-writer.emu.test.mjs\"",
    "test:staff:emu": "firebase emulators:exec --config tests/integration/firebase.staff-test.json --only firestore,auth --project demo-staff-provisioning \"node --test --test-reporter=spec tests/integration/staff-provisioning.emu.test.mjs\"",
    "serve": "node scratch/dev-server.js",
    "test:ownership:emu": "firebase emulators:exec --config tests/rules/firebase.rules-test.json --only firestore --project demo-ownership \"node --test --test-reporter=spec tests/integration/ownership.emu.test.mjs\""
  },
  "dependencies": {
    "puppeteer": "^25.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.0"
  }
}
