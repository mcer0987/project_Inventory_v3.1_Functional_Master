+        const batch = writeBatch(db);
+        for (let i = 1; i <= 3; i++) {
+            batch.update(item(db, 'b1', `p_c${i}`), { adet: 9, lastUpdate: 1, sonCikisId: `c${i}` });
+            batch.set(item(db, 'b3', `c${i}`), b3Entry(`c${i}`, { productId: `p_c${i}`, adet: 1 }));
+        }
