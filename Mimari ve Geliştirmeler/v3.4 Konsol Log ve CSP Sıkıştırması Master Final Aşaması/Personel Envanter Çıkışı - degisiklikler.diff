diff --git a/src/utils/exit-policy.js b/src/utils/exit-policy.js
new file mode 100644
index 0000000..5486cee
--- /dev/null
+++ b/src/utils/exit-policy.js
@@ -0,0 +1,70 @@
+// [WHY]: v3.4 · Personel (BT ekibi) çıkışı — envanter çıkışı yalnız yöneticideydi. BT ekibinin sarf malzeme çıkışı yapabilmesi,
+//        demirbaş çıkışının ise yine yalnız yöneticide kalması gerekiyor. Karar hem arayüzde hem Firestore kurallarında aynı
+//        ölçütle verilmeli; ikisi ayrışırsa personel formu doldurup sunucuda reddedilir.
+// [HOW]: Saf fonksiyonlar (DOM / Firebase yok, birim testli):
+//          eligibility(product, productTypes) → personel bu ürünün çıkışını yapabilir mi? Ölçüt firestore.rules
+//            staffExitB3Ok ile BİREBİR aynı: ürünün türü (tür/type) kataloğda KIRPILMIŞ ADIYLA birebir bulunan bir türe
+//            denk gelmeli ve o türün isDemirbas alanı tam olarak false olmalı. Tür kataloğda yoksa ya da ad farklı
+//            yazılmışsa (büyük/küçük harf dahil) karar verilemez → çıkış yöneticiye kalır (güvenli taraf).
+//          checkStaffPlan(stock, writes) → personelin gönderdiği işlem yalnız "stok düşümü + her ürün için TEK b3 çıkış
+//            kaydı" olabilir; aynı kayıt ürüne sonCikisId olarak bağlanır (kurallar bu bağla düşülen adedi doğrular).
+(function () {
+    const STOCK_COLS = ['b1', 'b2'];
+    // Personel toplu çıkışında en fazla kalem: kurallar kalem başına birkaç belge okur; emülatör ölçümünde 7 kalem geçti,
+    // 8 kalem Firestore'un istek başına belge erişimi sınırına takıldı (tests/rules/staff-exit.test.mjs). Bir kalem pay.
+    const STAFF_MAX_ITEMS = 6;
+    const trimmed = v => (typeof v === 'string' ? v.trim() : '');
+
+    const MESSAGES = Object.freeze({
+        demirbas: 'Bu ürün demirbaştır. Demirbaş çıkışını yalnız yönetici yapar; "Envanter Talep Et" ile yöneticiye talep gönderin.',
+        unknownType: 'Bu ürünün türü ürün türleri listesinde birebir bulunamadı; çıkışı yönetici yapabilir ya da "Envanter Talep Et" ile talep gönderebilirsiniz.',
+        noProduct: 'Ürün bulunamadı; liste güncellenmiş olabilir.',
+    });
+
+    function productTypeName(product) {
+        if (!product || typeof product !== 'object') return '';
+        return trimmed(product.tür) || trimmed(product.type);
+    }
+
+    // → { ok: true, typeId, typeName } | { ok: false, reason: 'demirbas'|'unknownType'|'noProduct', message }
+    function eligibility(product, productTypes) {
+        if (!product) return { ok: false, reason: 'noProduct', message: MESSAGES.noProduct };
+        const name = productTypeName(product);
+        const type = name ? (Array.isArray(productTypes) ? productTypes : [])
+            .find(t => t && typeof t.id === 'string' && t.id && trimmed(t.name) === name) : null;
+        if (!type) return { ok: false, reason: 'unknownType', message: MESSAGES.unknownType };
+        if (type.isDemirbas !== false) return { ok: false, reason: 'demirbas', message: MESSAGES.demirbas };
+        return { ok: true, typeId: type.id, typeName: name };
+    }
+
+    // stock: [{ col, id, delta }]  writes: [{ op, col, id, data }] (runStockOps'un hazırladığı biçim)
+    // → { ok: true, links: Map('col|id' → b3Id) } | { ok: false, error }
+    function checkStaffPlan(stock, writes) {
+        const fail = error => ({ ok: false, error });
+        if (!Array.isArray(stock) || !stock.length) return fail('Personel çıkışı en az bir ürün içermelidir.');
+        if (stock.length > STAFF_MAX_ITEMS) return fail(`Personel toplu çıkışı tek seferde en fazla ${STAFF_MAX_ITEMS} farklı ürün içerebilir; kalanları ikinci bir çıkışla yapın.`);
+        if (!Array.isArray(writes) || writes.length !== stock.length) return fail('Personel çıkışında her ürün için tek bir çıkış kaydı olmalıdır.');
+        const links = new Map();
+        for (const s of stock) {
+            if (!s || !STOCK_COLS.includes(s.col) || !Number.isInteger(s.delta) || s.delta >= 0) return fail('Personel yalnız stok düşen çıkış yapabilir.');
+            if (s.createIfMissing) return fail('Personel stok kaydı oluşturamaz.');
+            const key = `${s.col}|${s.id}`;
+            if (links.has(key)) return fail('Aynı ürün çıkışta iki kez yer alamaz.');
+            const w = writes.find(x => x && x.op === 'set' && x.col === 'b3' && x.data
+                && x.data.kaynakDepo === s.col && String(x.data.productId) === String(s.id));
+            if (!w) return fail('Her ürün için bir çıkış kaydı gerekir.');
+            const d = w.data;
+            if (d.tip !== 'cikis') return fail('Personel yalnız çıkış kaydı oluşturabilir.');
+            if (d.isDemirbas !== false) return fail(MESSAGES.demirbas);
+            if (d.adet !== -s.delta) return fail('Çıkış kaydındaki adet stok düşümüyle aynı olmalıdır.');
+            if (!trimmed(d.urunTuruId)) return fail(MESSAGES.unknownType);
+            if (!trimmed(d.islemYapanUid)) return fail('Çıkışı yapan kişi belirlenemedi.');
+            links.set(key, String(w.id));
+        }
+        if (writes.some(w => !w || w.op !== 'set' || w.col !== 'b3')) return fail('Personel çıkışında yalnız çıkış kaydı yazılabilir.');
+        if (new Set([...links.values()]).size !== links.size) return fail('Çıkış kayıtları birbirinden farklı olmalıdır.');
+        return { ok: true, links };
+    }
+
+    window.ExitPolicy = Object.freeze({ eligibility, checkStaffPlan, productTypeName, MESSAGES, STAFF_MAX_ITEMS });
+})();
diff --git a/src/ui/person-picker.js b/src/ui/person-picker.js
new file mode 100644
index 0000000..0b9afa7
--- /dev/null
+++ b/src/ui/person-picker.js
@@ -0,0 +1,130 @@
+// [WHY]: v3.4 · "Alan Kişi" çıkış ve toplu çıkış formlarında salt okunur ve her zaman oturumdaki kişiydi; yönetici başka bir
+//        personele çıkış yaptığında kayıt (ve Kişi Envanteri) yöneticinin üzerine düşüyordu.
+// [HOW]: PersonPicker — personel listesinden (window.data.personel, pasifler hariç) yazarak arayıp seçilen erişilebilir bir
+//        combobox; seçilen kişinin id'si gizli alana yazılır. Yalnız createElement/textContent kullanılır.
+//        ExitReceiver — iki formun alan kişisini kurar ve gönderimde çözer: yönetici listeden seçer (varsayılan kendisi);
+//        personel hesabında alan kişi kendisidir ve değiştirilemez (firestore.rules staffExitB3Ok aynısını zorunlu tutar).
+(function () {
+    const MAX_RESULTS = 8;
+    const norm = s => String(s ?? '').normalize('NFC').replace(/\s+/g, ' ').trim().toLocaleLowerCase('tr-TR');
+    const nameOf = p => String(p?.name || p?.adSoyad || p?.ad || '').trim();
+    const people = () => (window.data?.personel || []).filter(p => p && p.id != null && p.active !== false && nameOf(p));
+
+    function attach(input, hidden) {
+        if (!input || !hidden || input.dataset.personPicker === '1') return;
+        input.dataset.personPicker = '1';
+        const wrap = document.createElement('div');
+        wrap.className = 'person-picker';
+        input.parentNode.insertBefore(wrap, input);
+        wrap.append(input);
+        const list = document.createElement('ul');
+        list.className = 'person-picker-list';
+        list.id = `${input.id}List`;
+        list.setAttribute('role', 'listbox');
+        list.hidden = true;
+        wrap.append(list);
+        input.setAttribute('role', 'combobox');
+        input.setAttribute('aria-autocomplete', 'list');
+        input.setAttribute('aria-controls', list.id);
+        input.setAttribute('aria-expanded', 'false');
+        input.autocomplete = 'off';
+
+        let options = [], active = -1;
+        const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); active = -1; };
+        const choose = p => { input.value = nameOf(p); hidden.value = String(p.id); input.dataset.chosenName = nameOf(p); close(); };
+        const highlight = i => {
+            active = i;
+            [...list.children].forEach((li, k) => li.setAttribute('aria-selected', String(k === i)));
+            if (list.children[i]) { input.setAttribute('aria-activedescendant', list.children[i].id); list.children[i].scrollIntoView({ block: 'nearest' }); }
+        };
+        const render = () => {
+            if (input.readOnly) return;
+            const q = norm(input.value);
+            if (input.dataset.chosenName !== input.value) hidden.value = '';
+            options = people().filter(p => !q || norm(nameOf(p)).includes(q) || norm(p.pri).includes(q) || norm(p.birim || p.unit || '').includes(q))
+                .slice(0, MAX_RESULTS);
+            list.replaceChildren();
+            if (!options.length) {
+                const li = document.createElement('li');
+                li.className = 'person-picker-empty';
+                li.textContent = 'Eşleşen personel yok';
+                list.append(li);
+            }
+            options.forEach((p, i) => {
+                const li = document.createElement('li');
+                li.id = `${list.id}-${i}`;
+                li.setAttribute('role', 'option');
+                li.setAttribute('aria-selected', 'false');
+                const strong = document.createElement('strong');
+                strong.textContent = nameOf(p);
+                li.append(strong);
+                const meta = [p.pri, p.birim || p.unit].filter(Boolean).join(' · ');
+                if (meta) { const small = document.createElement('small'); small.textContent = meta; li.append(small); }
+                li.addEventListener('mousedown', e => { e.preventDefault(); choose(p); });
+                list.append(li);
+            });
+            list.hidden = false;
+            input.setAttribute('aria-expanded', 'true');
+            active = -1;
+        };
+        input.addEventListener('input', render);
+        // Odakta tüm metin seçilir (yazınca varsayılan ad değişir); fareyle odaklanınca mouseup seçimi bozmasın.
+        let justFocused = false;
+        input.addEventListener('focus', () => { if (!input.readOnly) { justFocused = true; input.select(); render(); } });
+        input.addEventListener('mouseup', e => { if (justFocused) { e.preventDefault(); justFocused = false; } });
+        input.addEventListener('blur', () => {
+            // Tam ad yazılıp listeden tıklanmadıysa tek eşleşme kabul edilir
+            if (!hidden.value) {
+                const exact = people().filter(p => norm(nameOf(p)) === norm(input.value));
+                if (exact.length === 1) choose(exact[0]);
+            }
+            close();
+        });
+        input.addEventListener('keydown', e => {
+            if (list.hidden || !options.length) return;
+            if (e.key === 'ArrowDown') { e.preventDefault(); highlight((active + 1) % options.length); }
+            else if (e.key === 'ArrowUp') { e.preventDefault(); highlight((active - 1 + options.length) % options.length); }
+            else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); choose(options[active]); }
+            else if (e.key === 'Escape') { e.preventDefault(); close(); }
+        });
+        input._personPick = choose;
+    }
+
+    const FORMS = { exit: ['exitPerson', 'exitPersonId'], cart: ['cartPerson', 'cartPersonId'] };
+    const els = kind => FORMS[kind].map(id => document.getElementById(id));
+
+    // Modal açılırken çağrılır.
+    function setup(kind, isAdmin) {
+        const [input, hidden] = els(kind);
+        if (!input || !hidden) return;
+        attach(input, hidden);
+        const me = window.getActiveUser?.() || {};
+        input.value = nameOf(me) || String(me.name || '');
+        hidden.value = me.id != null ? String(me.id) : '';
+        input.dataset.chosenName = input.value;
+        input.readOnly = !isAdmin;
+        input.placeholder = isAdmin ? 'Personel adı veya kurumsal kimlik yazın…' : '';
+        input.title = isAdmin ? 'Çıkışı alan personeli listeden seçin' : 'Personel çıkışında alan kişi siz olursunuz';
+    }
+
+    // Gönderimde çağrılır → { id, name } | null (uyarı gösterilmiştir)
+    function resolve(kind, isAdmin) {
+        const me = window.getActiveUser?.() || {};
+        if (!isAdmin) {
+            if (me.id == null || !String(me.name || '').trim()) { window.showAppAlert?.('Oturumdaki personel kaydı bulunamadı; sayfayı yenileyin.', 'error'); return null; }
+            return { id: String(me.id), name: String(me.name).trim() };
+        }
+        const [input, hidden] = els(kind);
+        const name = String(input?.value || '').trim();
+        if (!name) { window.showAppAlert?.('Lütfen "Alan Kişi" için bir personel seçin.', 'warning'); input?.focus(); return null; }
+        if (hidden?.value) return { id: hidden.value, name };
+        // Yönetici kendi adını değiştirmeden bıraktıysa (personel kaydı olmayan yönetici kimliği) eski davranış korunur.
+        if (name === String(me.name || '').trim()) return { id: me.id != null ? String(me.id) : null, name };
+        window.showAppAlert?.('Lütfen "Alan Kişi"yi listeden seçin; yazılan ad bir personelle eşleşmiyor.', 'warning');
+        input?.focus();
+        return null;
+    }
+
+    window.PersonPicker = Object.freeze({ attach });
+    window.ExitReceiver = Object.freeze({ setup, resolve });
+})();
diff --git a/src/ui/staff-guards.js b/src/ui/staff-guards.js
new file mode 100644
index 0000000..0ee6f35
--- /dev/null
+++ b/src/ui/staff-guards.js
@@ -0,0 +1,67 @@
+// [WHY]: v3.4 · BT ekibi (personel hesabı) çıkış ekranını kullanırken B1/B2 depoları onlar için yalnız görüntülenebilir olmalı.
+//        Depo çubuğundaki (.uab-bar) düğmeler personelde tıklanınca ayrı ayrı "yetkiniz yok" hatası veriyor ya da hiçbir şey
+//        söylemeden (Excel) çalışıyordu. Ayrıca depo ekranında sağ tık menüsü ve geliştirici araçları kısayolları açıktı.
+// [HOW]: 1) Oturum yönetici değilse <body> 'staff-readonly' sınıfı alır (görsel olarak pasif düğmeler + "Yalnız görüntüleme"
+//           rozeti). Asıl engel tıklama anında, yakalama (capture) aşamasında yapılır: yönetici değilse .uab-bar içindeki her
+//           etkileşim durdurulur ve tek bir açıklayıcı uyarı gösterilir. Sunucu tarafı zaten kurallarla kapalıdır.
+//        2) Bu sayfada (index.html) herkes için sağ tık menüsü ve geliştirici araçları / kaynak görüntüleme kısayolları
+//           (F12, Ctrl/Cmd+Shift+I/J/C/K, Ctrl/Cmd+U, Cmd+Option+I/J/C/U) engellenir. Not: tarayıcı menüsünden açılan
+//           geliştirici araçlarını hiçbir web sayfası engelleyemez; verinin asıl koruması Firestore kurallarıdır.
+(function () {
+    const READONLY_MESSAGE = '🔒 Depolar personel için yalnız görüntülenebilir. Sarf malzeme çıkışı için "Envanter Takibi" sekmesindeki "Envanter Çıkışı Yap" düğmesini kullanın.';
+    const isAdmin = () => typeof window.isDbAdmin === 'function' && window.isDbAdmin();
+    const loggedIn = () => document.body && document.body.classList.contains('logged-in');
+
+    function refresh() {
+        if (!document.body) return;
+        const readonly = loggedIn() && !isAdmin();
+        document.body.classList.toggle('staff-readonly', readonly);
+        document.querySelectorAll('.uab-bar .uab-btn, .uab-bar .uab-checkbox-wrap, .uab-bar input').forEach(el => {
+            if (readonly) el.setAttribute('aria-disabled', 'true'); else el.removeAttribute('aria-disabled');
+        });
+    }
+
+    let lastNotice = 0;
+    function notify(message) {
+        if (Date.now() - lastNotice < 1500) return;   // tek tık birden fazla olay üretir (label → input); tek uyarı yeter
+        lastNotice = Date.now();
+        if (typeof window.showAppAlert === 'function') window.showAppAlert(message, 'warning');
+    }
+
+    function guardDepotBar(e) {
+        const target = e.target instanceof Element ? e.target : null;
+        if (!target || !target.closest('.uab-bar') || isAdmin()) return;
+        e.preventDefault();
+        e.stopImmediatePropagation();
+        notify(READONLY_MESSAGE);
+    }
+    ['click', 'change', 'keydown'].forEach(type => document.addEventListener(type, e => {
+        if (type === 'keydown' && !['Enter', ' '].includes(e.key)) return;
+        guardDepotBar(e);
+    }, true));
+
+    // ─── Sağ tık ve geliştirici araçları kısayolları ──────────────────────────────────────────────────────
+    function isInspectShortcut(e) {
+        const key = String(e.key || '').toLowerCase();
+        if (key === 'f12') return true;
+        const mod = e.ctrlKey || e.metaKey;
+        if (mod && e.shiftKey && ['i', 'j', 'c', 'k'].includes(key)) return true;        // Windows/Linux, Firefox konsolu
+        if (e.metaKey && e.altKey && ['i', 'j', 'c', 'u'].includes(key)) return true;     // macOS
+        if (mod && !e.shiftKey && !e.altKey && key === 'u') return true;                   // kaynağı görüntüle
+        return false;
+    }
+    document.addEventListener('contextmenu', e => { e.preventDefault(); }, true);
+    document.addEventListener('keydown', e => {
+        if (!isInspectShortcut(e)) return;
+        e.preventDefault();
+        e.stopImmediatePropagation();
+    }, true);
+
+    ['onNavbarRendered', 'onAppLogout', 'onInventoryDataUpdated'].forEach(evt => window.addEventListener(evt, () => setTimeout(refresh, 0)));
+    document.addEventListener('DOMContentLoaded', refresh);
+    // 'logged-in' sınıfı giriş/çıkışta body'ye eklenir; aynı değerle toggle yeni değişiklik üretmez (döngü yok).
+    if (document.body) new MutationObserver(refresh).observe(document.body, { attributes: true, attributeFilter: ['class'] });
+    else document.addEventListener('DOMContentLoaded', () => new MutationObserver(refresh).observe(document.body, { attributes: true, attributeFilter: ['class'] }));
+
+    window.StaffGuards = Object.freeze({ refresh, isInspectShortcut, READONLY_MESSAGE });
+})();
