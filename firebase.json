{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      "**/node_modules/**",
      "backup/**",
      "backup_txt/**",
      "scratch/**",
      "functions/**",
      "Mimari ve Geliştirmeler/**",
      "**/*.md",
      "plan.json",
      "package*.json",
      "Dockerfile",
      "docker-compose.yml",
      "nginx.conf",
      "firestore.rules",
      ".agents/**",
      "tests/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
