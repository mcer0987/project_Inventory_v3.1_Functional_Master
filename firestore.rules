rules_version = '2';
// =============================================================================
// Rules v2 · Aşama B (Faz 4B · J10, PRI revizyonu) — personel başına Firebase Auth hesabı; anonim oturum YOK.
// Kaynak: Faz 4 Uygulama Planı §6 + GPT-6 J10 kuralları · Testler: tests/rules/rules.test.mjs (npm run test:rules)
// Kimlikler: yönetici (admin@medipol.local, e-posta/parola) · personel (<pri>@staff.medipol.local; staffAccounts/{uid} eşlemesi
// + personel kaydında AYNI uid ve AYNI PRI) · ziyaretçi (oturumsuz ya da bağsız hesap): HİÇBİR ŞEY okuyamaz (KVKK; giriş
// ekranı veritabanını okumaz — oturumsuz giriş rehberi kaldırıldı).
// Bilinçli sınırlamalar: yönetici yazmaları kısıtlanmaz (göç, geri yükleme) — istemci muhafızından geçer; akış başlatılırken
// talep sahibinin seçtiği onaylayıcı adı ile uid'nin aynı kişi olduğu kuralla doğrulanamaz (liste; bkz. J10 notu).
// DİKKAT: Kurallar proje geneli (canlı + demo). Yayın yalnız J10 istemcisiyle AYNI deploy'da ve personel hesapları açıldıktan
// sonra (VIP "PRI / Hesap Göç Aracı" — staffAccounts eşlemesini de o yazar); anonim sağlayıcı Console'da kapatılır.
// J11 · P0: personel erişimi kök başına bir KİLİDE bağlı (accessGate/items/staff). Doküman yok / alan yok / tip yanlış / false
// → hiçbir personel hiçbir şey okuyamaz ve yazamaz (fail-closed); yönetici etkilenmez. Kilit yalnız kapanış kanıtıyla açılır.
// Yayın sırası: "Faz 4B Mega Fix Walkthrough" → P0 runbook.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Admin = bilinen e-posta + e-posta/parola sağlayıcısı (anonim token'da e-posta iddiası geçmez).
    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.get('email', '') == 'admin@medipol.local'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isAdmin(root) {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'password'
        && (request.auth.token.get('email','') == 'admin@medipol.local'
          || (root == 'lifeserver_master' && request.auth.token.get('inventoryLiveAdmin','') != ''
            && request.auth.token.inventoryLiveAdmin == get(staffAccount(root)).data.get('personelId','')
            && isStaff(root)));
    }


    // J10 · personel: e-posta/parola oturumu, kurumsal kimlik e-postası (<pri>@staff.medipol.local) ve — asıl kanıt — yöneticinin
    // yazdığı hesap eşlemesi (staffAccounts/{uid} → personelId) ile o personel kaydındaki uid ve PRI'nin bu oturumla aynı olması.
    // Alan adı tek başına yetmez (istemciden hesap açma açıkken herkes kendine @staff.medipol.local hesabı açabilir; PRI'ler addan
    // tahmin edilebilir). Eşleme tek başına da yetmez: personel kaydının bağı kaldırılırsa (uid silinir) / PRI değişirse erişim biter.
    // PRI deseni istemcideki StaffProvisioning.PRI_RE ile aynı. Maliyet: personel isteği başına +2 doküman okuması.
    function staffPri() {
      return request.auth.token.email.lower().replace('@staff[.]medipol[.]local$', '');
    }
    function staffAccount(root) { return /databases/$(database)/documents/$(root)/staffAccounts/items/$(request.auth.uid); }
    function staffPersonOk(root, pid) {
      // Eksik/geçersiz pid yolu veya eksik kimlik alanı fail-closed olur; tekrar get/replace maliyeti yok.
      let person = get(/databases/$(database)/documents/$(root)/personel/items/$(pid)).data;
      return person.uid == request.auth.uid && request.auth.token.email.lower() == person.pri + '@staff.medipol.local'
        && person.get('active', true) == true;
    }
    // Kimlik (kilitten bağımsız): yalnız kilit dokümanının kendisini okumak için kullanılır (istemci "neden reddedildim" sorusunu
    // yanıtlayabilsin). Veri erişimi için HER ZAMAN isStaff.
    // J11: eşleme yolu ve personelId bir kez hesaplanır (kilit +1 okuma getirdi; en ağır onay isteği 1000 ifade sınırında kalsın).
    function staffIdentity(root) {
      let acct = staffAccount(root);
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.get('email', '').lower().matches('[a-z0-9]+([._-][a-z0-9]+)*@staff[.]medipol[.]local')
        && staffPersonOk(root, get(acct).data.get('personelId', ''));
    }

    // ─── J11 · P0 personel erişim kilidi (TEK KAYNAK) ─────────────────────────────────────────────────────
    // [WHY]: Kod temizliği bitene kadar personel kayıtlarında düz metin giriş kodu var; kod + sabit dolgu Firebase Auth parolası
    //        olduğundan bir personelin listeyi okuması hesap ele geçirme demek. Kurallar koleksiyonu tarayıp "temizlik bitti mi"
    //        diyemez → yöneticinin yazdığı açık bir durum alanı gerekir.
    // [HOW]: ${root}/accessGate/items/staff.staffAccessEnabled == true (bool) DEĞİLSE personel yok sayılır. isStaff bu kapıdan
    //        geçer; personelin tüm okuma / listeleme / yazma / silme yolları (iş akışı, denetim günlüğü, demo temizlik istisnası)
    //        isStaff ya da member üzerinden olduğu için hepsi tek noktadan kapanır. Bakım modu (maintenanceOn) ve istemcideki
    //        geri yükleme kilidi ayrı kalır: kilit kapalıyken onlara hiç sıra gelmez; açıkken eskisi gibi çalışırlar.
    //        Maliyet: personel isteği başına +1 doküman okuması (kilit kapalıyken diğer okumalara gerek kalmaz).
    function staffGate(root) { return /databases/$(database)/documents/$(root)/accessGate/items/staff; }
    function staffAccessOpen(root) {
      return get(staffGate(root)).data.get('staffAccessEnabled', false) == true;
    }
    function isStaff(root) { return staffAccessOpen(root) && staffIdentity(root); }
    // isStaff zaten ana yönetici e-postasını dışlar. Yetki iddiası yoksa yönetici kontrolü tekrarlanmaz.
    function regularStaff(root) {
      return isStaff(root) && (!request.auth.token.keys().hasAny(['inventoryLiveAdmin']) || !isAdmin(root));
    }
    function member(root) { return isAdmin(root) || isStaff(root); }

    // T1: canlı kök lifeserver_master (28.09.2026'dan beri) + localhost/demo kökü. inventory_v2 aşağıda ayrı (KJ-2).
    function validRoot(r) { return r in ['lifeserver_master', 'inventory_demo']; }

    // firebase-handler COLLECTIONS + doğrudan erişilen system_config ve workflowTemplates. auditLogs ve staffAccounts ayrı blokta.
    function knownCol(c) {
      return c in ['b1', 'b2', 'b3', 'personel', 'productTypes', 'purchaseOrders', 'serviceRecords',
                   'staff', 'units', 'locations', 'tasks', 'requests', 'assignments',
                   'system_config', 'workflowTemplates'];
    }

    function manualExitOk(id, d) {
      return d.keys().hasOnly(['id', 'sema', 'kime', 'nereye', 'cihaz', 'sn', 'envanterNo', 'isDemirbas',
          'adet', 'ekNot', 'cikisiIsteyen', 'personelId', 'actorUid', 'tarih', 'ts'])
        && d.keys().hasAll(['id', 'sema', 'kime', 'nereye', 'cihaz', 'sn', 'envanterNo', 'isDemirbas',
          'adet', 'ekNot', 'cikisiIsteyen', 'personelId', 'actorUid', 'tarih', 'ts'])
        && d.get('id', '') == id && d.get('sema', 0) == 1
        && d.get('kime', '') is string && d.kime.size() > 0 && d.kime.size() <= 160 && noTag(d.kime)
        && d.get('nereye', '') is string && d.nereye.size() > 0 && d.nereye.size() <= 200 && noTag(d.nereye)
        && d.get('cihaz', '') is string && d.cihaz.size() > 0 && d.cihaz.size() <= 200 && noTag(d.cihaz)
        && d.get('sn', '') is string && d.sn.size() <= 120 && noTag(d.sn)
        && d.get('envanterNo', '') is string && d.envanterNo.size() <= 120 && noTag(d.envanterNo)
        && d.get('isDemirbas', null) is bool
        && (!d.isDemirbas || d.envanterNo.size() > 0)
        && d.get('adet', 0) is int && d.adet >= 1
        && d.get('ekNot', '') is string && d.ekNot.size() <= 1000 && noTag(d.ekNot)
        && d.get('cikisiIsteyen', '') is string && d.cikisiIsteyen.size() > 0
        && d.cikisiIsteyen.size() <= 160 && noTag(d.cikisiIsteyen)
        && d.get('personelId', '') is string && d.personelId.size() <= 160
        && d.get('actorUid', '') is string && d.actorUid.size() > 0 && d.actorUid.size() <= 160
        && d.get('tarih', '') is string && d.tarih.size() > 0 && d.tarih.size() <= 60
        && d.get('ts', 0) is int && d.ts >= 0;
    }

    // Personelin yazabildiği iş akışı koleksiyonları. assignments/serviceRecords yalnız admin (T7).
    function staffWritable(c) { return c in ['purchaseOrders', 'requests', 'tasks']; }

    // RULE-05: bakım modu sunucu tarafında. Personel yazması başına +1 doküman okuması.
    function maintenanceOn(r) {
      let p = /databases/$(database)/documents/$(r)/system_config/items/admin_settings;
      return exists(p) && get(p).data.get('maintenance', false) == true;
    }

    // XSS savunma derinliği: "<harf", "</", "<!", "<?" reddedilir; "<5mm", "a < b" serbest (istemci: html.js hasTagLike).
    function noTag(v) { return !(v is string) || !v.matches('(?s).*<[a-zA-Z/!?].*'); }

    // J11: koleksiyon dalı ?: ile seçilir (yalnız seçilen dal değerlendirilir; 1000 ifade bütçesi — bkz. walkthrough ölçümleri).
    function textOk(c, d) {
      return noTag(d.get('id', ''))
        && (c == 'requests' ? (
             noTag(d.get('ürün', '')) && noTag(d.get('urun', '')) && noTag(d.get('not', ''))
             && noTag(d.get('personel', '')) && noTag(d.get('talepTuru', '')) && noTag(d.get('oncelik', '')))
          : c == 'tasks' ? (
             noTag(d.get('title', '')) && noTag(d.get('description', '')) && noTag(d.get('priority', ''))
             && noTag(d.get('assigneeId', '')) && noTag(d.get('creatorId', '')))
          : c == 'purchaseOrders' ? (
             noTag(d.get('urun', '')) && noTag(d.get('aciklama', '')) && noTag(d.get('talepEden', ''))
             && noTag(d.get('birim', '')) && noTag(d.get('tur', '')) && noTag(d.get('evrakNo', ''))
             && noTag(d.get('oncelik', '')) && noTag(d.get('createdByName', '')))
          : true);
    }

    // ─── Sahiplik (J9 alanları; J10'da ZORUNLU) ──────────────────────────────────────────────────────────
    function ownerField(c) {
      return c == 'requests' ? 'personelUid' : (c == 'purchaseOrders' ? 'createdByUid' : 'creatorUid');
    }
    function ownerUnchanged(c, d, old) { return d.get(ownerField(c), null) == old.get(ownerField(c), null); }
    // J11 · P1 #7 + J11.5 (bağımsız denetim): liste ya AYNEN kalır ya da sona TEK kayıt eklenir (önek korunur). Eklenen kayıt:
    //   - aktör alanı (f) sahibin adı (me),
    //   - uid'si oturumun uid'si (request.auth.uid — ek get() yok),
    //   - türü (tf alanı: history 'action', akış 'islem') o işlemin istemcide ürettiği türlerden biri (kinds). kinds boşsa o işlem
    //     o listeye HİÇ kayıt ekleyemez (ör. taslak düzenleme history'ye yazmaz).
    // Akış history'sinde manuel create, metadata içeren şablon create ve withdraw ayrı allowlist'lerle sınırlandırılır;
    // required=true kayıtsız yazmayı da reddeder. metadata nesnesinin iç anahtarları bu sözleşmenin kapsamı dışındadır.
    // Sahibin taslak / başlatma / geri çekme / iptal işlemleri istemcide en fazla bir history ve bir akış kaydı ekler; sahibin
    // kendi taslağına "Onaylandı" ya da başkasının uid'siyle olay eklemesi böylece reddedilir.
    function ownerEventOk(a, b, me, tf, kinds, required, templateStart) {
      let k = a.size();
      let f = tf == 'action' ? 'actor' : 'yapan';
      return (b.size() == k && !required && b == a)
        || (b.size() == k + 1 && b[k].get(f, '') == me && b[k].get('uid', '') == request.auth.uid
           && b[k].get(tf, '') in kinds
           && (tf != 'action'
             ? b[k].keys().hasOnly(['islem', 'yapan', 'uid', 'tarih'])
             : (b[k].get('action', '') == 'create'
               ? (templateStart
                 ? b[k].keys().hasOnly(['id', 'from', 'to', 'actor', 'uid', 'timestamp', 'action', 'note', 'metadata'])
                 : b[k].keys().hasOnly(['action', 'actor', 'uid', 'timestamp', 'to']))
               : b[k].keys().hasOnly(['action', 'actor', 'uid', 'timestamp', 'from', 'to', 'note'])))
           && (k == 0 || b[0:k] == a));
    }

    // ─── J11 · P1 #5/#7: oturum sahibinin GERÇEK personel kimliği ─────────────────────────────────────────
    // [WHY]: Kurallar sahiplik UID'sini doğruluyordu ama görünen kimlik alanlarını (talepEden, createdByName, personel,
    //        creatorId, onay adımındaki actor/user, akis.yapan, history.actor) istemcinin yazdığı gibi kabul ediyordu.
    // [HOW]: isStaff'ın ZATEN okuduğu iki belgeden (staffAccounts/{uid} → personelId, personel/{pid}) türetilir; Firestore aynı
    //        yolları istek içinde önbellekler — yeni belge okuması ve O(N) sorgu yok. Ad, istemcideki
    //        Ownership.selfName ile AYNI öncelikle (name → adSoyad → ad) ve kırpılarak hesaplanır.
    function staffPid(root) { return get(staffAccount(root)).data.get('personelId', ''); }
    function staffName(root) {
      let pid = staffPid(root);
      let pd = get(/databases/$(database)/documents/$(root)/personel/items/$(pid)).data;
      let n1 = pd.get('name', '');
      let n2 = pd.get('adSoyad', '');
      let nm = (n1 is string && n1 != '') ? n1 : ((n2 is string && n2 != '') ? n2 : pd.get('ad', ''));
      return nm is string ? nm.trim() : '';
    }

    // Yeni / taslak akış adımı: henüz karara bağlanmamış (status 'pending' ya da yok) ve onaylayıcısı talep sahibinin kendisi
    // değil. Kurallar liste üzerinde döngü kuramadığı için adım sayısı en fazla 10 ve her indeks açıkça denetlenir (istemci de 10
    // ile sınırlar). J11: satır içi ve 'pending' eşitliği — 10 adımlı başlatma isteği 1000 ifade bütçesine kimlik denetimleriyle
    // birlikte ancak böyle sığıyor (eski "approved/rejected değil" biçimi 'cancelled' gibi değerleri de kabul ediyordu; istemci
    // akışı her zaman 'pending' adımlarla başlatır, taslakta adım listesi boştur).
    function freshSteps(s, owner) {
      let n = s.size();
      return n <= 10
        && (n <= 0 || (s[0].get('status', 'pending') == 'pending' && s[0].get('userUid', '') != owner))
        && (n <= 1 || (s[1].get('status', 'pending') == 'pending' && s[1].get('userUid', '') != owner))
        && (n <= 2 || (s[2].get('status', 'pending') == 'pending' && s[2].get('userUid', '') != owner))
        && (n <= 3 || (s[3].get('status', 'pending') == 'pending' && s[3].get('userUid', '') != owner))
        && (n <= 4 || (s[4].get('status', 'pending') == 'pending' && s[4].get('userUid', '') != owner))
        && (n <= 5 || (s[5].get('status', 'pending') == 'pending' && s[5].get('userUid', '') != owner))
        && (n <= 6 || (s[6].get('status', 'pending') == 'pending' && s[6].get('userUid', '') != owner))
        && (n <= 7 || (s[7].get('status', 'pending') == 'pending' && s[7].get('userUid', '') != owner))
        && (n <= 8 || (s[8].get('status', 'pending') == 'pending' && s[8].get('userUid', '') != owner))
        && (n <= 9 || (s[9].get('status', 'pending') == 'pending' && s[9].get('userUid', '') != owner));
    }

    // ─── Envanter talebi (requests) ───────────────────────────────────────────────────────────────────────
    // J11 · P1 #7: talep sahibinin adı (personel) ve personel id'si oturumun GERÇEK kaydıyla aynı olmalı. Güncellemede bu alanlar
    // requestUpdateOk'un hasOnly listesinde olmadığı için zaten değiştirilemez.
    function requestCreateOk(root, d) {
      return d.get('personelUid', '') == request.auth.uid && d.get('durum', '') in ['Beklemede', 'draft']
        && d.get('personel', '') == staffName(root)
        && string(d.get('personelId', '')) == staffPid(root);
    }
    // Sahibi: bekleyen/taslak talebi düzenler, geri çeker (draft), yeniden gönderir (Beklemede); onaylanmışı teslim alır (completed).
    // Onaylama / reddetme / zimmet alanları yalnız yönetici.
    function requestUpdateOk(old, d) {
      return old.get('personelUid', '') == request.auth.uid && (
        (old.get('durum', '') in ['', 'Beklemede', 'Bekliyor', 'BEKLEMEDE', 'pending', 'draft']
          && d.get('durum', '') in ['Beklemede', 'draft']
          && d.diff(old).affectedKeys().hasOnly(['ürün', 'adet', 'talepTuru', 'oncelik', 'not', 'iadeTarihi', 'durum', 'tarih']))
        || (old.get('durum', '') == 'approved' && d.get('durum', '') == 'completed'
          && d.diff(old).affectedKeys().hasOnly(['durum', 'teslimTarihi'])));
    }

    // ─── Satın alma (purchaseOrders) ──────────────────────────────────────────────────────────────────────
    // [WHY]: Eski tek ürünlü kayıtlar kalemsiz okunur; yeni kalemlerin tip, sınır ve metin güvenliği sunucuda doğrulanır.
    // [HOW]: Pilot sınırı üç konum; her biri sabit yol üzerinden denetlenir, kurallar dizi üzerinde döngü desteklemez.
    function poLineOk(v) {
      return v is map && v.keys().hasAll(['id', 'description', 'category', 'quantity', 'unit', 'unitPrice', 'currency', 'taxRate', 'totalPrice'])
        && noTag(v.description)
        && v.currency in ['TRY', 'USD', 'EUR']
        && v.quantity > 0 && v.unitPrice >= 0 && v.taxRate >= 0 && v.taxRate <= 100 && v.totalPrice >= 0;
    }
    function poItemsOk(d) {
      let a = d.get('items', []);
      let totals = d.get('totals', {});
      let n = a is list ? a.size() : 0;
      return d.get('documentTypeCode', 'PURCHASE_REQUEST') == 'PURCHASE_REQUEST'
        && (!d.keys().hasAny(['items', 'totals']) || (
        n >= 1 && n <= 3
        && totals is map && totals.keys().hasAll(['TRY', 'USD', 'EUR'])
        && poLineOk(a[0])
        && (n == 1 || (poLineOk(a[1])
            && (n == 2 || poLineOk(a[2]))))));
    }
    function poFxFieldsOk(d) {
      let rates = d.get('exchangeRate', {});
      return rates is map && rates.keys().hasOnly(['TRY', 'USD', 'EUR']) && rates.get('TRY', 0) == 1
        && rates.get('USD', 0) is number && rates.get('USD', 0) >= 0 && rates.get('USD', 0) <= 100000
        && rates.get('EUR', 0) is number && rates.get('EUR', 0) >= 0 && rates.get('EUR', 0) <= 100000
        && d.get('exchangeRateDate', '') is string && d.exchangeRateDate.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.get('exchangeRateSource', '') is string && d.exchangeRateSource.trim().size() > 0
        && d.exchangeRateSource.size() <= 120 && noTag(d.exchangeRateSource)
        && d.get('reportingTotalTRY', -1) is number && d.reportingTotalTRY >= 0 && d.reportingTotalTRY <= 1000000000;
    }
    function poPathId(docId, d) {
      return d.id == docId || (d.id is int && string(d.id) == docId);
    }
    function poFxSnapshot(d) {
      return {'exchangeRate':d.exchangeRate, 'exchangeRateDate':d.exchangeRateDate,
              'exchangeRateSource':d.exchangeRateSource, 'reportingTotalTRY':d.reportingTotalTRY};
    }
    function poFxDecisionOk(root, docId, old, d, step, status) {
      let fields = ['exchangeRate', 'exchangeRateDate', 'exchangeRateSource', 'reportingTotalTRY'];
      let snapshot = ebysPath(root,'purchaseFinance',docId);
      return status == 'approved' && step == 0
        ? (old.keys().hasAny(fields)
            ? old.keys().hasAll(fields) && !d.diff(old).affectedKeys().hasAny(fields)
            : d.id == docId && !exists(snapshot) && getAfter(snapshot).data == poFxSnapshot(d))
        : !d.diff(old).affectedKeys().hasAny(fields);
    }
    function poInitialEventOk(d, me) {
      let a = d.get('akis', []);
      return a.size() == 0 || (a.size() == 1
        && a[0].get('islem', '') == 'Talep Oluşturuldu'
        && a[0].get('yapan', '') == me && a[0].get('uid', '') == request.auth.uid
        && a[0].keys().hasOnly(['islem', 'yapan', 'uid', 'tarih']));
    }
    // J11 · P1 #7: talebi açanın görünen kimliği (createdBy = personel id, createdByName, talepEden) oturumun GERÇEK kaydıyla aynı;
    // yeni talep geçmişsiz başlar (history yok) ve en fazla tek "Talep Oluşturuldu" akış kaydı taşır — o da sahibin adıyla
    // (savePurchaseRequest ile aynı). Önceden "onaylandı" yazan sahte geçmişle talep açılamaz.
    function poCreateOk(root, d) {
      let wf = d.get('workflow', {});
      let me = staffName(root);
      return poItemsOk(d) && !d.keys().hasAny(['exchangeRate', 'exchangeRateDate', 'exchangeRateSource', 'reportingTotalTRY'])
        && d.get('createdByUid', '') == request.auth.uid
        && d.get('durum', '') in ['Onay Bekliyor', 'Taslak']
        && wf.get('started', false) != true && wf.get('finished', false) != true
        && wf.get('steps', []).size() == 0
        && d.get('createdByName', '') == me && d.get('talepEden', '') == me
        && string(d.get('createdBy', '')) == staffPid(root)
        && wf.get('history', []).size() == 0
        && wf.get('currentState', 'initiation') == 'initiation'
        && poInitialEventOk(d, me);
    }
    // Sahibi, akış BAŞLAMAMIŞKEN: düzenler, akışı başlatır (adımlar kararsız, kendisi onaylayıcı değil), iptal eder.
    // J11.6 · P1 (bağımsız denetim): workflow.currentState sahibin yazmasında İSTEMCİNİN GERÇEK değerine bağlı (WorkflowEngine esas):
    //   oluşturma alanı yazmaz ya da initiation (poCreateOk) · başlatma INITIATION (confirmStartWorkflow / createWorkflowFromTemplate)
    //   · düzenleme / ek silme DEĞİŞTİRMEZ · iptal CANCELLED, yalnız motorun cancelled'a geçişe izin verdiği bir durumdan
    //   (WorkflowEngine.transitions) · geri çekme INITIATION (poWithdrawOk; taslağa dönüş motor geçişi değil, sıfırlamadır — eski
    //   durum sınırlanmaz, aksi hâlde hr / finance / director'dan meşru geri çekme kırılırdı). Admin listesi başlamış ve
    //   'completed' akışı "Tamamlandı" gösterir; onaysız talep böylece tamamlanmış görünemez. Üst düzey durum (durum) ve adım
    //   durumları (steps[].status: freshSteps → pending) ayrı denetlenir.
    // J11 · P1 #7: talep sahibinin görünen kimliği (createdBy / createdByName / talepEden) taslakta da DEĞİŞTİRİLEMEZ. Sahibin her
    // işlemi (düzenleme, ek silme, başlatma, iptal) istemcide en fazla bir history ve bir akış kaydı ekler; eklenen kayıt sahibin
    // KENDİ adını taşımak zorunda (başkası adına "onayladı" kaydı düşülemez). Sahibin adı olarak kayıttaki createdByName
    // kullanılır: J11 sonrası açılan her talepte poCreateOk onu staffName'e bağlar ve burada değiştirilemez (aynı değer, ek
    // belge okumasız — 10 adımlı başlatma bütçesi staffName'in ek maliyetini kaldırmıyor).
    function poDraftOk(old, d) {
      let wf = old.get('workflow', {});
      let nwf = d.get('workflow', {});
      let me = old.get('createdByName', '');
      let changed = d.diff(old).affectedKeys();
      let started = nwf.get('started',false) == true;
      let status = d.get('durum','');
      return (!old.keys().hasAny(['exchangeRate'])
            || (!started
                && !changed.hasAny(['items', 'totals', 'urun', 'adet', 'butce', 'budgetMode', 'budgetEstimateRates', 'documentTypeCode', 'aciklama', 'birim', 'tur', 'evrakNo', 'files', 'oncelik'])))
        && (!changed.hasAny(['items', 'totals', 'exchangeRate', 'exchangeRateDate', 'exchangeRateSource', 'reportingTotalTRY'])
            || (poItemsOk(d) && !changed.hasAny(['exchangeRate', 'exchangeRateDate', 'exchangeRateSource', 'reportingTotalTRY'])))
        && wf.get('started', false) != true
        && !changed.hasAny(['createdBy', 'createdByName', 'talepEden'])
        && old.get('durum', '') in ['Onay Bekliyor', 'Taslak', '']
        && status in ['Onay Bekliyor', 'Taslak', 'İptal Edildi']
        && (started
            ? freshSteps(nwf.get('steps', []), request.auth.uid)
            : nwf.get('steps', []).size() == 0)
        && nwf.get('currentStep', 0) == 0
        && (nwf.get('finished', false) != true || status == 'İptal Edildi')
        && (!started || status == 'Onay Bekliyor')
        && (started ? nwf.get('currentState', '') == 'initiation'
            : (status == 'İptal Edildi'
               ? nwf.get('currentState', '') == 'cancelled'
                 && wf.get('currentState', 'initiation') in ['initiation', 'manager_approval', 'hr_approval', 'finance_approval', 'director_approval', 'suspended']
               : nwf.get('currentState', null) == wf.get('currentState', null)))
        // J11.7 · P1 (bağımsız denetim): ownerEventOk "kayıt eklenmemesini" de kabul eder; başlatma ve iptalde istemcinin ürettiği
        // kayıt ZORUNLU (başlatma: +1 history 'create' +1 akış; iptal: +1 akış). Düzenleme / ek silme dalı değişmedi.
        && ownerEventOk(wf.get('history', []), nwf.get('history', []), me, 'action', started ? ['create'] : [],
             started, nwf.get('templateId', null) != null)
        && ownerEventOk(old.get('akis', []), d.get('akis', []), me, 'islem', started ? ['İş akışı başlatıldı']
             : (status == 'İptal Edildi' ? ['Talep İptal Edildi'] : ['Talep güncellendi', 'Ek dosya silindi']),
             started || status == 'İptal Edildi', false);
    }
    // Sahibi, akış SÜRERKEN: yalnız geri çeker (taslağa döner; içerik değişmez, geçmiş korunur).
    function poWithdrawOk(old, d) {
      let wf = old.get('workflow', {});
      let nwf = d.get('workflow', {});
      let me = old.get('createdByName', '');
      return wf.get('started', false) == true && wf.get('finished', false) != true
        && d.diff(old).affectedKeys().hasOnly(['id', 'workflow', 'durum', 'akis'])
        && d.get('durum', '') == 'Taslak'
        && nwf.get('started', true) == false && nwf.get('finished', true) == false
        && nwf.get('steps', [1]).size() == 0 && nwf.get('currentStep', -1) == 0
        && nwf.get('currentState', '') == 'initiation'
        // J11.7 · P1: geri çekme kaydı zorunlu (istemci: +1 history 'withdraw' +1 akış); tür / uid / aktör ownerEventOk'ta
        && ownerEventOk(wf.get('history', []), nwf.get('history', []), me, 'action', ['withdraw'], true, false)
        && ownerEventOk(old.get('akis', []), d.get('akis', []), me, 'islem', ['Talep Geri Çekildi (Taslak Moduna Alındı)'], true, false);
    }
    // ONAY ADIMI (GPT-6 + J11 · P1 #5): yalnız SIRASI GELMİŞ adımın onaylayıcısı (steps[currentStep].userUid == auth.uid; talep
    // sahibi olamaz), yalnız o adımın karar alanlarını (status/date/actor/note) değiştirir. Diğer adımlar birebir aynı kalır
    // (dilim eşitliği), onaylayıcı kimliği (user/userUid) değişemez, sıra / bitiş / durum kararla tutarlı.
    // J11 · P1 #5 — sahte olay / sahte aktör:
    //   - Eklenen kayıt SAYISI edm-workflow.js'in gerçek davranışıyla birebir: onay = +1 history +1 akis (transitionWorkflowState
    //     + approveStep'in tek akis.push'u); red = +1 history +3 akis (aynı transition + rejectStep'in üç akis.push'u: red,
    //     state geçişi, modal kaydı). edm-workflow.js'te bu sayı değişirse kural da güncellenmeli (rules testleri yakalar).
    //   - Adımın actor'u, yeni history kaydının actor'u ve yeni akış kayıtlarının yapan'ı onaylayanın GERÇEK adı (staffName).
    // J11 · P1 #7 — sahte onaylayıcı: sıradaki adımın görünen onaylayıcısı (steps[cs].user) da onaylayanın gerçek adı olmalı.
    //   Talep sahibi "Müdür X" adıyla başka birinin uid'sini adıma yazmış olsa bile o uid'nin sahibi bu adımı ONAYLAYAMAZ (yalnız
    //   yönetici). Karşılaştırma tam ya da küçük harf eşitliğidir; istemci (_resolveWorkflowSteps) adı personel kaydındaki
    //   biçime zaten normalize eder.
    // "Bayat onay" tekrar oynatımı engellidir: cs HER ZAMAN sunucudaki GÜNCEL currentStep'tir; akış ilerlediyse eski payload ya
    //   onaylayıcı uid'sinde ya da dilim eşitliği / sıra-durum kontrolünde düşer. İkinci kez onay da aynı nedenle düşer.
    // Bilinçli sınırlama: date / tarih / timestamp istemci saatidir (request.time zorunlu kılınmadı — mevcut kayıtlar ISO / tr-TR
    //   metin olarak okunuyor; değiştirmek çalışan akışı kırar). Adım adlarının uid ile eşleşmesi akış BAŞLARKEN değil (10 adımda
    //   20 ek belge okuması gerekir — istek başına 10 get() sınırı), KARAR ANINDA zorunlu tutulur.
    // J11 · P1 #5 kapanışı (bağımsız denetim) — aynı SAYIDA ama farklı İÇERİKLİ olay:
    //   - Güncellenen adımın ESKİ durumu 'pending' olmalı: verilmiş bir kararın üzerine (onaylı → red, onaylı → tekrar onay;
    //     currentStep'in geride kaldığı bozuk eski kayıtlar) yazılamaz. Böyle bir kayıt yöneticiye kalır.
    //   - Eklenen history kaydı bir 'transition' olayıdır ve uid'si oturumun uid'si (request.auth.uid; ek get() yok). Eklenen her
    //     akış kaydı da aynı uid'yi taşır. Aynı adlı iki personel olsa bile kaydı kimin yazdığı uid ile ayırt edilir.
    //   - Olay türü kararla tutarlı: onayda akış kaydı "✅ Onaylandı: …"; redde sırasıyla "❌ REDDEDİLDİ: …", "🔄 State Geçişi: …",
    //     "❌ Reddedildi: …" (edm-workflow.js rejectStep), history kaydı 'cancelled' durumuna geçer ve red gerekçesi (adımın
    //     note'u, boş olamaz) akış kayıtlarına ve history notuna aynen taşınır. Onayda adımın note'u değişmez.
    //   - Bilinçli sınırlama: tarih alanları (timestamp / tarih / date) istemci saatidir; sunucu saatine bağlanamaz (dizi içinde
    //     serverTimestamp yok, veri katmanı JSON kopyası alır). Onayda history'nin from/to değerleri bağlanmadı: istemcinin durum
    //     döngüsü 6+ adımlı akışta 'completed'a geçip fixWorkflowCurrentStep ile 'initiation'a döner (meşru akış kırılırdı).
    function poApprovalOk(root, docId, old, d) {
      let wf = old.get('workflow', {});
      let nwf = d.get('workflow', {});
      let cs = wf.currentStep;
      let n = wf.steps.size();
      let st = nwf.steps[cs].status;
      let hSize = wf.get('history', []).size();
      let aSize = old.akis.size();
      let me = staffName(root);
      let stepUser = string(wf.steps[cs].get('user', '')).trim();
      let uid = request.auth.uid;
      return wf.started == true && wf.get('finished', false) != true && wf.get('currentState', '') != 'suspended'
        && cs is int && cs >= 0 && cs < n
        && wf.steps[cs].get('userUid', '') == uid
        && wf.steps[cs].get('status', 'pending') == 'pending'
        && old.get('createdByUid', '') != uid
        && me != '' && (stepUser == me || stepUser.lower() == me.lower())
        && (old.keys().hasAny(['items'])
            ? d.diff(old).affectedKeys().hasOnly(['id', 'workflow', 'durum', 'akis', 'exchangeRate', 'exchangeRateDate', 'exchangeRateSource', 'reportingTotalTRY'])
              && poFxDecisionOk(root, docId, old, d, cs, st)
            : d.diff(old).affectedKeys().hasOnly(['id', 'workflow', 'durum', 'akis']))
        && nwf.diff(wf).affectedKeys().hasOnly(['steps', 'currentStep', 'finished', 'currentState', 'history', 'started'])
        && nwf.started == true
        && nwf.steps.size() == n
        && (cs == 0 || nwf.steps[0:cs] == wf.steps[0:cs])
        && (cs + 1 == n || nwf.steps[cs + 1:n] == wf.steps[cs + 1:n])
        && nwf.steps[cs].diff(wf.steps[cs]).affectedKeys().hasOnly(['status', 'date', 'actor', 'note'])
        && nwf.steps[cs].get('actor', '') == me
        && (hSize == 0 || nwf.history[0:hSize] == wf.get('history', []))
        && nwf.history.size() == hSize + 1
        && nwf.history[hSize].actor == me
        && nwf.history[hSize].uid == uid
        && nwf.history[hSize].action == 'transition'
        && (aSize == 0 || d.akis[0:aSize] == old.get('akis', []))
        && (st == 'approved'
          ? (nwf.currentStep == cs + 1 && nwf.get('finished', false) == (cs + 1 == n)
              && d.durum == (cs + 1 == n ? 'Onaylandı' : 'Onay Bekliyor')
              && nwf.steps[cs].get('note', '') == wf.steps[cs].get('note', '')
              && nwf.history[hSize].keys().hasOnly(['id', 'from', 'to', 'actor', 'uid', 'timestamp', 'action', 'note', 'metadata'])
              && nwf.history[hSize].get('to', '') != 'cancelled'
              // J11.5 · P1 (bağımsız denetim): onaylayıcı akışın genel durumunu sahte bir değere (cancelled / suspended / …)
              // çekemez. Son adımda 'completed'; değilse approveStep'in durum makinesinin TEK meşru ardılı (eski durumdan):
              // initiation → manager → hr → finance → director → (completed, fixWorkflowCurrentStep ile) initiation. Boş /
              // hatalı 'completed' eski durum istemcide initiation sayılır (onarım) → manager_approval.
              && nwf.currentState == (cs + 1 == n ? 'completed'
                   : {'': 'manager_approval', 'initiation': 'manager_approval', 'completed': 'manager_approval',
                      'manager_approval': 'hr_approval', 'hr_approval': 'finance_approval',
                      'finance_approval': 'director_approval', 'director_approval': 'initiation'}.get(wf.get('currentState', ''), '-'))
              && d.akis.size() == aSize + 1
              && d.akis[aSize].yapan == me && d.akis[aSize].uid == uid
              && d.akis[aSize].islem.matches('✅ Onaylandı: .*')
              && d.akis[aSize].keys().hasOnly(['islem', 'yapan', 'uid', 'tarih', 'note']))
          : (st == 'rejected' && nwf.currentStep == cs && nwf.finished == true
              && d.durum == 'Reddedildi' && nwf.currentState == 'cancelled'
              && poRejectAkisOk(d.akis, aSize, nwf.history[hSize], nwf.steps[cs].get('note', ''), me, uid)));
    }
    // Red: tam +3 akış kaydı, üçü de onaylayanın adı + uid'siyle, rejectStep'in sırası ve türleriyle; gerekçe boş olamaz ve her
    // kayıtta aynı. Üç kayıt şeması (ortak + stateNote) ve history kök anahtarları sınırlıdır; metadata içeriği kapsam dışıdır.
    // history kaydı 'cancelled'a geçiş ve notu "Reddedildi: <gerekçe>".
    function poRejectAkisOk(a, k, h, why, me, uid) {
      return why is string && why.trim() != '' && a.size() == k + 3
        && h.keys().hasOnly(['id', 'from', 'to', 'actor', 'uid', 'timestamp', 'action', 'note', 'metadata'])
        && h.to == 'cancelled' && h.note == 'Reddedildi: ' + why
        && a[k].yapan == me && a[k].uid == uid
        && a[k].islem.matches('❌ REDDEDİLDİ: .*') && a[k].not == why
        && a[k].keys().hasOnly(['islem', 'yapan', 'uid', 'tarih', 'not'])
        && a[k + 1].yapan == me && a[k + 1].uid == uid
        && a[k + 1].islem.matches('🔄 State Geçişi: .*') && a[k + 1].not == 'Reddedildi: ' + why
        && a[k + 1].keys() == a[k].keys()
        && a[k + 2].yapan == me && a[k + 2].uid == uid
        && a[k + 2].islem.matches('❌ Reddedildi: .*') && a[k + 2].not == why
        && a[k + 2].keys().hasOnly(['islem', 'yapan', 'uid', 'tarih', 'not', 'stateNote']);
    }
    // Sahibi: akış başlamamışsa taslak işlemleri, başlamışsa yalnız geri çekme (sahibi değilse onay adımı: poApprovalOk; dağıtım
    // update kuralında ?: ile — yalnız seçilen dal değerlendirilir).
    function poOwnerUpdateOk(root,docId,old,d) {
      return old.get('workflow',{}).get('started',false) == true
        ? poWithdrawOk(old,d) && poKeepHistory(root,docId,old,d) : poDraftOk(old,d);
    }

    // ─── Görev (tasks) ────────────────────────────────────────────────────────────────────────────────────
    // Oluşturan: her alanı (sahiplik hariç). Atanan: yalnız durum / mesaj / alt madde. Havuz görevleri yönetici atar.
    // J11 · P1 #7: oluşturanın görünen adı (creatorId) oluşturmada oturum sahibinin gerçek adı, sonra DEĞİŞTİRİLEMEZ.
    function taskUpdateOk(old, d) {
      return (old.get('creatorUid', '') == request.auth.uid && !d.diff(old).affectedKeys().hasAny(['creatorId']))
        || (old.get('assigneeUid', '') == request.auth.uid
            && d.diff(old).affectedKeys().hasOnly(['status', 'interactions', 'checklist', 'updatedAt']));
    }

    // ─── Personel kayıtları: giriş kodu (düz metin) yeniden YAZILAMAZ (J10 · kod temizliği) ─────────────────
    // Yeni kayıtta kod yok; güncellemede var olan kod yalnız aynen kalabilir ya da silinebilir (Kod Temizliği aracı).
    function personelCodeOk(d) {
      return !d.keys().hasAny(['code'])
        || (resource != null && resource.data.keys().hasAny(['code']) && d.code == resource.data.code);
    }

    // J11 · P1 #6: KJ-5 demo test silme istisnası (__flowtest__ işaretli belgeyi HER personelin silebilmesi) KALDIRILDI. İşaret
    // personelin yazabildiği metin alanlarında aranıyordu; bu yüzden yetkisiz silmeye ve bakım modunun aşılmasına izin veriyordu
    // (zimmet ve servis kayıtları dahil). Test temizliği artık yalnız yönetici oturumuyla ya da emülatörde kuralları atlayan yönetim
    // erişimiyle yapılır (scratch/flow-tests.js).

    // ─── v3.3 · Aşama 2/3 · B1/B2 yazma sözleşmesi (Denetim P1-02 · sunucu tarafı) ─────────────────────────────────────
    // [WHY]: b1/b2'ye yönetici yazmaları hiç içerik denetiminden geçmiyordu: eksi / ondalık adet ya da eski alan adı (ör. b1'e
    //        'status' — toplu pasife alma hatası) yalnız istemci muhafızına bağlıydı.
    // [HOW]: Yeni eski alan EKLENEMEZ (var olan eski alan göç edilmemiş belgede değişebilir: computeStockPatch onu da yazar);
    //        adet yazılıyorsa ≥ 0 tam sayı. Toplu geri yükleme / içe aktarma kilidi (admin_settings.restoreLock — atomic-writer)
    //        sürerken muaf: geri alma, belgelerin ÖNCEKİ (eski biçimli olabilen) hâlini yazabilmelidir; yoksa geri alma takılır.
    //        Kilit okuması yalnız sözleşme tutmazsa yapılır (|| kısa devre) — olağan yazmada ek belge okuması yok.
    //        Sınır (Spark planı, tek yönetici kimliği): kurallar b1/b2 adet değişiminin raf sayacıyla AYNI commit'te yapıldığını
    //        zorlamaz; bütün yazma yolları stok defterine geçirilene kadar (Aşama 3 devamı) sayaç Aşama 6'da uzlaştırılır.
    function stockLegacyKeys(c) { return c == 'b1' ? ['name', 'type', 'shelf', 'qty', 'status'] : ['name', 'type', 'shelf', 'qty']; }
    function stockQtyOk(d) { return d.get('adet', 0) is int && d.get('adet', 0) >= 0; }
    function restoreLockOn(r) {
      let p = /databases/$(database)/documents/$(r)/system_config/items/admin_settings;
      return exists(p) && get(p).data.get('restoreLock', null) != null;
    }
    function stockCreateOk(r, c, d) {
      return (!d.keys().hasAny(stockLegacyKeys(c)) && stockQtyOk(d)) || restoreLockOn(r);
    }
    function stockUpdateOk(r, c, d, old) {
      return (!d.diff(old).addedKeys().hasAny(stockLegacyKeys(c))
              && (!d.diff(old).affectedKeys().hasAny(['adet']) || stockQtyOk(d)))
        || restoreLockOn(r);
    }

    // ─── v3.4 · Personel (BT ekibi) SARF çıkışı ──────────────────────────────────────────────────────────────
    // [WHY]: Envanter çıkışı yalnız yöneticideydi; 10 kişilik BT ekibi sarf malzeme çıkışı yapacak. Demirbaş çıkışı yine yalnız
    //        yöneticide (personel "Envanter Talep Et" ile ister). İstemci kontrolü tek başına yetmez: personel konsoldan doğrudan
    //        stok düşebilir ya da demirbaş için kayıt yazabilirdi.
    // [HOW]: İki yazma AYNI commit'te ve birbirine bağlı (istemci: runStockOps staffExit · ExitPolicy.checkStaffPlan):
    //        - b1/b2 güncellemesi yalnız stok DÜŞÜMÜ (+ computeStockPatch'in durum alanları) ve yeni sonCikisId; bu id commit
    //          öncesinde OLMAYAN, commit sonrasında bu ürünü, bu depoyu, düşülen adedi ve oturumun uid'sini taşıyan b3 kaydı.
    //        - b3 oluşturma yalnız 'cikis', isDemirbas false; ürünün türü katalogdaki (urunTuruId) türle KIRPILMIŞ adla birebir
    //          aynı ve o türün isDemirbas alanı false (istemcideki Schema.isDemirbas'ta da tür tanımı önceliklidir); ürün
    //          commit sonrasında bu kayda bağlı ve aradaki adet farkı kayıttaki adet. Alan kişi oturumdaki personelin kendisi.
    //        Raf sayaçları personele yazdırılmaz (shelves bloğu); bkz. firebase-handler runStockOps notu.
    function b3Doc(r, id) { return /databases/$(database)/documents/$(r)/b3/items/$(id); }
    function staffExitStockOk(r, c, pid, old, d) {
      let exitId = d.get('sonCikisId', '');
      let keys = d.diff(old).affectedKeys();
      let e = getAfter(b3Doc(r, exitId)).data;
      return c in ['b1', 'b2'] && exitId is string && exitId.size() > 0 && exitId.size() <= 80
        && exitId != old.get('sonCikisId', '')
        && keys.hasOnly(['adet', 'qty', 'lastUpdate', 'durumu', 'status', 'stokOncekiDurum', 'sonCikisId'])
        && keys.hasAll(['adet', 'sonCikisId'])
        && old.get('adet', null) is int && stockQtyOk(d) && d.adet < old.adet
        && (!keys.hasAny(['qty']) || d.get('qty', null) == d.adet)
        && (!keys.hasAny(['durumu', 'status', 'stokOncekiDurum'])
            || (d.adet == 0 && d.get('durumu', 'Tükendi') == 'Tükendi' && d.get('status', 'Tükendi') == 'Tükendi'
                && d.get('stokOncekiDurum', '') is string && d.get('stokOncekiDurum', '').size() <= 60))
        && !exists(b3Doc(r, exitId))
        && string(e.get('productId', '')) == pid && e.get('kaynakDepo', '') == c
        && e.get('adet', 0) == old.adet - d.adet && e.get('islemYapanUid', '') == request.auth.uid;
    }
    function staffExitB3Ok(r, id, d) {
      let c = d.get('kaynakDepo', '');
      let pid = string(d.get('productId', ''));
      let before = get(stockDoc(r, c, pid)).data;
      let after = getAfter(stockDoc(r, c, pid)).data;
      let t = get(/databases/$(database)/documents/$(r)/productTypes/items/$(string(d.get('urunTuruId', '-')))).data;
      let tur = before.get('tür', '') is string && before.get('tür', '').trim() != '' ? before.get('tür', '') : before.get('type', '');
      return c in ['b1', 'b2'] && string(d.get('id', '')) == id
        && d.keys().hasOnly(['id', 'sema', 'tip', 'kaynakDepo', 'productId', 'requestId', 'rafNo', 'sutun', 'urunTuruId', 'urunTuru',
             'urunAciklama', 'marka', 'adet', 'sn', 'envanterNo', 'not', 'alanKisi', 'personelId', 'tarih', 'ts', 'isDemirbas',
             'talepTuru', 'oncelik', 'iadeTarihi', 'iadeEdildi', 'iadeEdildiTarihi', 'iadeDepo', 'onaylayan', 'islemYapanUid'])
        && d.get('sema', 0) == 2 && d.get('tip', '') == 'cikis' && d.get('isDemirbas', null) == false
        && d.get('adet', 0) is int && d.adet >= 1
        && d.get('requestId', null) == null && d.get('talepTuru', null) == null && d.get('iadeEdildi', null) == false
        && d.get('islemYapanUid', '') == request.auth.uid
        && string(d.get('personelId', '')) == staffPid(r)
        && noTag(d.get('not', '')) && noTag(d.get('sn', '')) && noTag(d.get('alanKisi', '')) && noTag(d.get('envanterNo', ''))
        && after.get('sonCikisId', '') == id
        && before.get('adet', 0) - after.get('adet', 0) == d.adet
        && t.get('isDemirbas', true) == false
        && tur is string && t.get('name', '') is string && t.name.trim() == tur.trim();
    }

    // [WHY]: Tanımlarda ID ve hiyerarşi istemci dışından da korunur; silme yerine pasifleştirme.
    // [HOW]: En fazla dört üst birim getAfter ile doğrulanır; aynı batch'teki döngüler de reddedilir.
    function definitionKey(v) { return v is string && v.size() <= 120 && !v.matches('.*[<>/].*'); }
    function unitPath(r, id) { return /databases/$(database)/documents/$(r)/units/items/$(id); }
    function ancestorOk(d, id, org) {
      return string(d.get('id', '')) != id && d.get('organizationId', '') == org;
    }
    function parent4(r, id, p, org) {
      let d = getAfter(unitPath(r, p)).data;
      return ancestorOk(d, id, org) && d.get('parentUnitId', '') == '';
    }
    function parent3(r, id, p, org) {
      let d = getAfter(unitPath(r, p)).data;
      return ancestorOk(d, id, org) && (d.get('parentUnitId', '') == '' || parent4(r, id, d.parentUnitId, org));
    }
    function parent2(r, id, p, org) {
      let d = getAfter(unitPath(r, p)).data;
      return ancestorOk(d, id, org) && (d.get('parentUnitId', '') == '' || parent3(r, id, d.parentUnitId, org));
    }
    function parent1(r, id, p, org) {
      let d = getAfter(unitPath(r, p)).data;
      return ancestorOk(d, id, org) && (d.get('parentUnitId', '') == '' || parent2(r, id, d.parentUnitId, org));
    }
    function unitDefinitionOk(r, id, d) {
      return string(d.get('id', id)) == id && d.get('active', true) is bool
        && definitionKey(d.get('parentUnitId', '')) && definitionKey(d.get('organizationId', ''))
        && definitionKey(d.get('code', '')) && noTag(d.get('name', ''))
        && d.get('personnelIds', []) is list && d.get('personnel', []) is list
        && (d.get('parentUnitId', '') == '' || parent1(r, id, d.parentUnitId, d.get('organizationId', '')));
    }
    function personDefinitionOk(r, id, d) {
      return string(d.get('id', id)) == id && d.get('active', true) is bool
        && definitionKey(d.get('unitId', '')) && d.get('jobTitle', '') is string
        && d.get('jobTitle', '').size() <= 160 && noTag(d.get('jobTitle', ''))
        && (d.get('unitId', '') == '' || existsAfter(unitPath(r, d.unitId)));
    }
    function definitionOk(r, c, id, d) {
      return c == 'units' ? unitDefinitionOk(r, id, d) : (c == 'personel' ? personDefinitionOk(r, id, d) : true);
    }
    function definitionLinkOk(r, c, d, old) {
      return c == 'units' ? (d.get('parentUnitId', '') == ''
          || d.get('parentUnitId', '') == old.get('parentUnitId', '')
          || getAfter(unitPath(r, d.parentUnitId)).data.get('active', true) == true)
        : (c != 'personel' || d.get('unitId', '') == '' || d.get('unitId', '') == old.get('unitId', '')
          || getAfter(unitPath(r, d.unitId)).data.get('active', true) == true);
    }
    match /{root}/manualExits/items/{docId} {
      allow read: if validRoot(root) && member(root);
      allow create, update: if validRoot(root) && isAdmin(root) && manualExitOk(docId, request.resource.data);
      allow delete: if validRoot(root) && isAdmin(root);
    }

    match /{root}/{col}/items/{docId} {
      // Ek D "Ziyaretçi ✗": oturumsuz / anonim / personele bağlı olmayan hesap hiçbir şey okuyamaz.
      allow read: if validRoot(root) && knownCol(col) && member(root)
        && (col != 'purchaseOrders' || isAdmin(root) || lpRead(root,docId,resource.data,request.auth.uid));

      // Admin: tüm bilinen koleksiyonlar; bakım modundan etkilenmez. Personel kaydına düz metin kod yeniden giremez.
      // v3.3: b1/b2 içerik sözleşmesi (stockCreateOk / stockUpdateOk).
      allow create: if isAdmin(root) && validRoot(root) && knownCol(col)
        && definitionOk(root, col, docId, request.resource.data)
        && (col != 'purchaseOrders' || (poPathId(docId,request.resource.data) && poItemsOk(request.resource.data)))
        && (col != 'purchaseOrders' || !request.resource.data.keys().hasAny(['exchangeRate', 'exchangeRateDate', 'exchangeRateSource', 'reportingTotalTRY']))
        && definitionLinkOk(root, col, request.resource.data, {})
        && (col != 'personel' || personelCodeOk(request.resource.data))
        && (!(col in ['b1', 'b2']) || stockCreateOk(root, col, request.resource.data));
      allow update: if isAdmin(root) && validRoot(root) && knownCol(col)
        && definitionOk(root, col, docId, request.resource.data)
        && (col != 'purchaseOrders' || (poPathId(docId,request.resource.data) && poKeepHistory(root,docId,resource.data,request.resource.data)))
        && (col != 'purchaseOrders' || !request.resource.data.keys().hasAny(['items'])
            || request.resource.data.get('workflow', {}).get('steps', []).size() == 0
            || request.resource.data.workflow.steps[0].get('status', '') != 'approved'
            || poFxDecisionOk(root, docId, resource.data, request.resource.data, 0, 'approved'))
        && (col != 'purchaseOrders' || (poItemsOk(request.resource.data)
          && (resource.data.get('workflow', {}).get('started', false) != true && !resource.data.keys().hasAny(['exchangeRate'])
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['items', 'totals', 'urun', 'adet', 'butce', 'budgetMode', 'budgetEstimateRates', 'documentTypeCode', 'aciklama', 'birim', 'tur', 'evrakNo', 'files', 'oncelik']))
          && (!resource.data.keys().hasAny(['exchangeRate']) || resource.data.get('workflow', {}).get('started', false) == true
              || request.resource.data.get('workflow', {}).get('started', false) != true)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['exchangeRate', 'exchangeRateDate', 'exchangeRateSource', 'reportingTotalTRY'])
              || (resource.data.get('workflow', {}).get('started', false) == true
                  && resource.data.workflow.get('currentStep', -1) == 0
                  && !resource.data.keys().hasAny(['exchangeRate', 'exchangeRateDate', 'exchangeRateSource', 'reportingTotalTRY'])
                  && request.resource.data.get('workflow', {}).get('steps', []).size() > 0
                  && request.resource.data.workflow.steps[0].get('status', '') == 'approved'
                  && poFxFieldsOk(request.resource.data)))))
        && definitionLinkOk(root, col, request.resource.data, resource.data)
        && (!(col in ['units', 'personel']) || request.resource.data.get('id', null) == resource.data.get('id', null))
        && (col != 'personel' || resource.data.get('uid', '') == ''
            || request.resource.data.get('uid', '') == resource.data.uid)
        && (col != 'units' || resource.data.get('organizationId', '') == ''
            || request.resource.data.get('organizationId', '') == resource.data.organizationId)
        && (col != 'personel' || personelCodeOk(request.resource.data))
        && (!(col in ['b1', 'b2']) || stockUpdateOk(root, col, request.resource.data, resource.data));
      allow delete: if validRoot(root) && knownCol(col) && isAdmin(root) && !(col in ['units', 'personel']);

      // Personel: yalnız iş akışı koleksiyonları, bakım kapalıyken, etiketsiz metinle; sahiplik zorunlu ve değişmez.
      allow create: if validRoot(root) && regularStaff(root)
        && staffWritable(col) && !maintenanceOn(root) && textOk(col, request.resource.data)
        && (col == 'requests' ? requestCreateOk(root, request.resource.data)
            : col == 'purchaseOrders' ? poPathId(docId,request.resource.data) && poCreateOk(root, request.resource.data)
            : (request.resource.data.get('creatorUid', '') == request.auth.uid
                && request.resource.data.get('creatorId', '') == staffName(root)));
      // J11 · P1 #5: textOk onay dalında değerlendirilmez — onaylayıcı textOk'un baktığı hiçbir alanı değiştiremez
      // (poApprovalOk: affectedKeys yalnız workflow / durum / akis); kazanılan ifade bütçesi kayıt içerik denetimlerine gider.
      // J11.5: sahibin satın alma yolunda textOk yalnız textOk'un baktığı alanlardan biri DEĞİŞİYORSA çalışır (başlatma / geri
      // çekme / iptal bu alanlara dokunmaz). Değişmeyen değer sahibin bu yazmada getirdiği yeni metin değildir; etiket savunması
      // aynı kalır. Kazanılan bütçe 10 adımlı başlatmadaki sahibin olay türü / uid denetimine (ownerEventOk) gider.
      allow update: if validRoot(root) && regularStaff(root)
        && staffWritable(col) && !maintenanceOn(root)
        && ownerUnchanged(col, request.resource.data, resource.data)
        && (col == 'requests' ? textOk(col, request.resource.data) && requestUpdateOk(resource.data, request.resource.data)
            : col == 'purchaseOrders' ? poPathId(docId,request.resource.data) && (resource.data.get('createdByUid', '') == request.auth.uid
                ? (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'urun', 'aciklama', 'talepEden', 'birim', 'tur',
                      'evrakNo', 'oncelik', 'createdByName']) || textOk(col, request.resource.data))
                  && poOwnerUpdateOk(root,docId,resource.data,request.resource.data)
                : poApprovalOk(root, docId, resource.data, request.resource.data))
            : textOk(col, request.resource.data) && taskUpdateOk(resource.data, request.resource.data));

      // v3.4 · personel (BT ekibi) SARF çıkışı: stok düşümü + bağlı b3 kaydı aynı commit'te (staffExitStockOk / staffExitB3Ok).
      allow update: if validRoot(root) && col in ['b1', 'b2'] && regularStaff(root) && !maintenanceOn(root)
        && staffExitStockOk(root, col, docId, resource.data, request.resource.data);
      allow create: if validRoot(root) && col == 'b3' && regularStaff(root) && !maintenanceOn(root)
        && staffExitB3Ok(root, docId, request.resource.data);

      // Silme: personel yalnız KENDİ oluşturduğu görevi; talepler, satın almalar, zimmet ve servis kayıtları admin'e ait.
      allow delete: if validRoot(root) && regularStaff(root) && col == 'tasks' && !maintenanceOn(root)
        && resource.data.get('creatorUid', '') == request.auth.uid;
    }

    // J10 · personel hesap eşlemesi (uid → personelId, pri): isStaff'ın dayanağı. Yalnız yönetici okur / yazar; personel kendi
    // eşlemesini yazamaz (kendine hesap açan biri kendini personele bağlayamaz). Kurallar get() ile okur (okuma izninden bağımsız).
    // Oturumsuz giriş rehberi (staffDirectory) KALDIRILDI: eşleşen kural yok → herkese kapalı.
    match /{root}/staffAccounts/items/{uid} {
      allow read, write: if validRoot(root) && isAdmin(root);
    }

    // J11 · P0 erişim kilidi. Okuma: yönetici ve (kilit kapalıyken de) kimliği doğrulanmış personel — yalnız durum + sayılar, kişisel
    // veri yok. Yazma yalnız yönetici: KAPATMA her zaman serbest; AÇMA yalnız kapanış kanıtıyla (closureOk). Silme = kapatma.
    // Bilinçli sınırlama: kurallar kanıttaki sayıların gerçekten sunucudan sayıldığını doğrulayamaz (yönetici güvenilir taraf; istemci
    // yolu VIP "Personel Erişim Kilidi" aracıdır ve sayıları sunucudan taze okur). Kanıt şeması, sıfır olmayan sayı, eksik / fazla
    // alan, istemci saati ve başkası adına imza reddedilir.
    function gateBaseOk(d) {
      return d.keys().hasOnly(['staffAccessEnabled', 'changedAt', 'changedBy', 'reason', 'closure', 'version'])
        && d.get('staffAccessEnabled', null) is bool
        && d.get('version', 0) == 1
        && d.get('changedAt', null) == request.time
        && d.get('changedBy', '') == request.auth.uid
        && d.get('reason', '') is string && d.get('reason', '').size() <= 300 && noTag(d.get('reason', ''));
    }
    // Kapanış kanıtı: J11'in sekiz denetimi, hepsi 0 (eksik / fazla anahtar yok). İstemcideki karşılığı Ownership.CLOSURE_CHECKS.
    function closureOk(c) {
      return c is map
        && c.keys().hasAll(['personelCodes', 'requestCodes', 'purchaseOrderCodes', 'accountsMissing', 'accountsInconsistent',
                            'accountMapMismatch', 'ownershipPending', 'ownershipUnresolved'])
        && c.keys().hasOnly(['personelCodes', 'requestCodes', 'purchaseOrderCodes', 'accountsMissing', 'accountsInconsistent',
                             'accountMapMismatch', 'ownershipPending', 'ownershipUnresolved'])
        && c.personelCodes == 0 && c.requestCodes == 0 && c.purchaseOrderCodes == 0
        && c.accountsMissing == 0 && c.accountsInconsistent == 0 && c.accountMapMismatch == 0
        && c.ownershipPending == 0 && c.ownershipUnresolved == 0;
    }
    function gateWriteOk(d) {
      return gateBaseOk(d) && (d.staffAccessEnabled == false || closureOk(d.get('closure', null)));
    }
    match /{root}/accessGate/items/{gateId} {
      allow read: if validRoot(root) && gateId == 'staff' && (isAdmin(root) || staffIdentity(root));
      allow create, update: if validRoot(root) && gateId == 'staff' && isAdmin(root) && gateWriteOk(request.resource.data);
      allow delete: if validRoot(root) && gateId == 'staff' && isAdmin(root);
    }

    // ─── v3.3 · Aşama 2/3 · Raf kataloğu (Denetim P1-02) — ${root}/shelves/items/{depot}_{KOD} ───────────────────────
    // [WHY]: Raf kapasitesi tarayıcıya özel localStorage'daydı; ortak ve sunucuda denetlenen bir kapasite yoktu.
    // [HOW]: İstemci sözleşmesi Schema.validateShelfDoc / shelfDocId ile birebir: yalnız SHELF_KEYS, kimlik = depo + '_' + kod,
    //        kanonik kod deseni, kapasite 1–200, usedSlots ≥ 0, sunucu saati ve yazanın uid'i. Kod ve depo değiştirilemez.
    //        Slot ARTIŞI kapasiteyi aşamaz (eşzamanlı son-slot yarışında transaction + bu kural); AZALIŞ her zaman serbest
    //        (geçiş sonrası aşımdaki raf boşaltılabilmeli — Aşama 6). Kapasite güncel kullanımın altına indirilemez.
    //        Oluşturmada usedSlots > capacity serbest (geçişte mevcut aşım görünür kalmalı; istemci servisi yeni rafı
    //        kullanımın altında kapasiteyle oluşturmaz). Silme yalnız boş rafta.
    //        Okuma: member (personel dahil). Denetim raporu "signedIn" öneriyordu; istemciden hesap açma açıkken bu, personele
    //        bağlı olmayan herhangi bir hesaba okuma verirdi (KVKK Ek D ilkesi) — bilinçli olarak daha dar.
    //        v3.3 P1 (Excel içe aktarma sayacı): raf sayaçları ürünlerle AYNI AtomicWriter işinde yazılır. Çok parçalı işin geri
    //        alınması rafın ÖNCEKİ belgesini (eski updatedAt / updatedBy) yazar ve bu işte yaratılmış — dolu — rafı siler;
    //        ikisi de olağan kurala takılır. Bu yüzden YALNIZ toplu yazma kilidi (restoreLock) sürerken: şekli geçerli belge
    //        zaman/uid kanıtı olmadan yazılabilir, dolu raf silinebilir (b1/b2 muafiyetiyle aynı desen). Kod/depo yine sabit.
    function shelfShapeOk(shelfId, d) {
      return d.keys().hasOnly(['code', 'depot', 'capacity', 'usedSlots', 'active', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['code', 'depot', 'capacity', 'usedSlots', 'active', 'updatedAt', 'updatedBy'])
        && d.depot in ['b1', 'b2']
        && d.code is string && d.code.size() >= 1 && d.code.size() <= 40
        && d.code.matches('[A-Z0-9ÇĞÖŞÜ][A-Z0-9ÇĞÖŞÜ ._-]*')
        && shelfId == d.depot + '_' + d.code
        && d.capacity is int && d.capacity >= 1 && d.capacity <= 200
        && d.usedSlots is int && d.usedSlots >= 0
        && d.active is bool;
    }
    function shelfDocOk(shelfId, d) {
      return shelfShapeOk(shelfId, d)
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }
    match /{root}/shelves/items/{shelfId} {
      allow read: if validRoot(root) && member(root);
      allow create: if validRoot(root) && isAdmin(root) && shelfDocOk(shelfId, request.resource.data);
      allow update: if validRoot(root) && isAdmin(root)
        && request.resource.data.code == resource.data.code
        && request.resource.data.depot == resource.data.depot
        && ((shelfDocOk(shelfId, request.resource.data)
             && (request.resource.data.usedSlots <= resource.data.usedSlots
                 || request.resource.data.usedSlots <= request.resource.data.capacity)
             && (request.resource.data.capacity == resource.data.capacity
                 || request.resource.data.capacity >= request.resource.data.usedSlots))
            || (restoreLockOn(root) && shelfShapeOk(shelfId, request.resource.data)));
      allow delete: if validRoot(root) && isAdmin(root)
        && (resource.data.get('usedSlots', 0) == 0 || restoreLockOn(root));
    }

    // ─── v3.3 · Aşama 2 · Stok işlem defteri (Denetim P1-01 mükerrerlik) — ${root}/stockOperations/items/{operationId} ──
    // [WHY]: Yanıtı kaybolan bir transfer tekrar gönderildiğinde stok ikinci kez düşebiliyordu.
    // [HOW]: Transaction işlem kaydını ürün ve sayaç yazmalarıyla AYNI commit'te oluşturur; kayıt varsa istemci stoğa dokunmaz.
    //        Yalnız ekleme (create; aynı kimliğe ikinci yazma update'tir → reddedilir), değiştirilemez, silinemez.
    //        Kayıt GERÇEK sonuçla çapraz denetlenir (getAfter: commit sonrası hâl): hedef kaydın adedi = qty; kaynak kayıt
    //        tam taşımada silinmiş, kısmi taşımada adedi = stockAfter (aynı depoda tam taşımada kaynak = hedef).
    function stockDoc(r, c, id) { return /databases/$(database)/documents/$(r)/$(c)/items/$(id); }
    function stockOpOk(r, opId, d) {
      return d.keys().hasOnly(['id', 'kind', 'sourceCol', 'sourceId', 'targetCol', 'targetId', 'targetShelfId', 'qty', 'fullMove',
                               'stockBefore', 'stockAfter', 'shelves', 'uid', 'ts'])
        && d.keys().hasAll(['id', 'kind', 'sourceCol', 'sourceId', 'targetCol', 'targetId', 'targetShelfId', 'qty', 'fullMove',
                            'stockBefore', 'stockAfter', 'shelves', 'uid', 'ts'])
        && opId.matches('[A-Za-z0-9_-]{8,80}') && d.id == opId
        && d.kind == 'transfer'
        && d.sourceCol in ['b1', 'b2'] && d.targetCol in ['b1', 'b2']
        && d.sourceId is string && d.targetId is string && d.targetShelfId is string
        && d.qty is int && d.qty >= 1 && d.fullMove is bool
        && d.stockBefore is int && d.stockAfter is int && d.stockAfter == d.stockBefore - d.qty && d.stockAfter >= 0
        && d.fullMove == (d.stockAfter == 0)
        && d.shelves is list && d.shelves.size() <= 2
        && d.uid == request.auth.uid && d.ts == request.time
        && getAfter(stockDoc(r, d.targetCol, d.targetId)).data.get('adet', -1) == d.qty
        && (d.sourceCol == d.targetCol && d.sourceId == d.targetId
            ? true
            : (d.fullMove ? !existsAfter(stockDoc(r, d.sourceCol, d.sourceId))
                          : getAfter(stockDoc(r, d.sourceCol, d.sourceId)).data.get('adet', -1) == d.stockAfter));
    }
    match /{root}/stockOperations/items/{opId} {
      allow read: if validRoot(root) && isAdmin(root);
      allow create: if validRoot(root) && isAdmin(root) && stockOpOk(root, opId, request.resource.data);
      allow update, delete: if false;
    }

    // Denetim günlüğü (4.7 · KJ-7): yalnız ekleme, katı şema, sunucu saati, kendi uid'i; admin dahil kimse düzeltemez/silemez.
    match /{root}/auditLogs/items/{logId} {
      allow read: if validRoot(root) && isAdmin(root);
      allow create: if validRoot(root) && member(root)
        && request.resource.data.keys().hasOnly(['id', 'type', 'refCol', 'refId', 'item', 'qty', 'actorName',
             'actorPersonelId', 'uid', 'authKind', 'result', 'reason', 'page', 'ts'])
        && request.resource.data.result in ['blocked', 'approved', 'cancelled']
        && request.resource.data.ts == request.time
        && request.resource.data.uid == request.auth.uid
        && noTag(request.resource.data.get('item', '')) && noTag(request.resource.data.get('actorName', ''))
        && noTag(request.resource.data.get('reason', '')) && noTag(request.resource.data.get('type', ''));
      allow update, delete: if false;
    }

    // KJ-2: eski canlı kök (canlı site artık kullanmıyor, veri korunuyor) — yalnız admin (yedek / göç).
    match /inventory_v2/{document=**} {
      allow read, write: if isPrimaryAdmin();
    }

    // EBYS evrakları genel knownCol / satın alma yazma yoluna dahil değildir.
    function ebysPath(r, c, id) { return /databases/$(database)/documents/$(r)/$(c)/items/$(id); }
    function ebysId(id) { return id is string && id.matches('[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}'); }
    function ebysText(v, max, required) { return v is string && v.size() <= max && (!required || v.trim().size() > 0) && noTag(v); }
    function ebysMetadata(m) {
      return m is map && m.keys().hasAll(['subject','correspondent','date','filePlanCode','confidentiality','distribution','externalRegistrationNo'])
        && m.keys().hasOnly(['subject','correspondent','date','filePlanCode','confidentiality','distribution','externalRegistrationNo'])
        && ebysText(m.subject, 240, true) && ebysText(m.correspondent, 240, true)
        && m.date is string && m.date.matches('\\d{4}-\\d{2}-\\d{2}') && ebysText(m.filePlanCode, 40, true)
        && m.confidentiality in ['Normal','Hizmete Özel','Gizli'] && ebysText(m.distribution, 2000, false)
        && ebysText(m.externalRegistrationNo, 120, false);
    }
    function ebysOwn(r, d) { return validRoot(r) && member(r) && d.ownerUid == request.auth.uid; }
    function ebysCommand(r, d, command) {
      let op = getAfter(ebysPath(r, 'ebysOperations', d.lastOperationId)).data;
      return !exists(ebysPath(r,'ebysOperations',d.lastOperationId))
        && op.ownerUid == request.auth.uid && op.documentId == d.id && op.command == command && op.revision == d.revision;
    }
    function ebysHead(d, id) {
      return d.keys().hasOnly(['id','ownerUid','kind','unitId','organizationCode','state','currentVersionId','versionNo','registrationNo','revision','lastOperationId','createdAt','updatedAt'])
        && d.id == id && ebysId(id) && ebysId(d.lastOperationId) && d.kind in ['incoming','outgoing','internal']
        && ebysText(d.unitId, 128, true) && d.organizationCode.matches('[A-Z0-9]{2,12}')
        && d.state in ['draft','registered','in_review','internally_approved','returned','rejected','withdrawn'] && d.revision is int && d.revision > 0
        && d.versionNo is int && d.updatedAt == request.time;
    }
    function ebysActiveUnit(r, d) { return get(ebysPath(r, 'units', d.unitId)).data.get('active', true) == true; }
    function ebysDraftHead(r, d) {
      let draft = getAfter(ebysPath(r, 'ebysDrafts', d.id)).data;
      return d.state in ['draft','registered'] && d.currentVersionId == '' && d.versionNo >= 0
        && draft.revision == d.revision && draft.ownerUid == d.ownerUid && ebysCommand(r, d, 'saveDraft') && ebysActiveUnit(r, d);
    }
    function ebysHeadUpdate(r, old, d) {
      return ebysHead(d, old.id) && d.ownerUid == old.ownerUid && d.createdAt == old.createdAt
        && d.kind == old.kind && d.organizationCode == old.organizationCode && d.revision == old.revision + 1
        && (old.state in ['draft','registered'] && d.state == old.state && d.versionNo == old.versionNo && d.registrationNo == old.registrationNo && ebysDraftHead(r, d)
          || (old.state in ['draft','registered'] && d.state == 'in_review' && d.unitId == old.unitId
            && d.registrationNo == old.registrationNo && d.versionNo == old.versionNo+1 && ebysId(d.currentVersionId)
            && getAfter(ebysPath(r, 'ebysVersions', d.currentVersionId)).data.documentId == d.id && ebysCommand(r, d, 'freezeVersion'))
          || (old.currentVersionId != '' && d.state == 'draft' && d.versionNo == old.versionNo && d.registrationNo == old.registrationNo
            && get(ep(r,old.currentVersionId)).data.state in ['returned','rejected','withdrawn'] && ebysDraftHead(r,d))
          || (old.registrationNo == '' && old.state in ['draft','in_review'] && d.state == (old.state == 'draft' ? 'registered' : old.state)
            && d.unitId == old.unitId && d.currentVersionId == old.currentVersionId && d.versionNo == old.versionNo
            && getAfter(ebysPath(r, 'ebysRegistrationIds', d.registrationNo)).data.documentId == d.id && ebysCommand(r, d, 'registerDocument')));
    }
    // Aşama 7 · Belge yolu özel kalır. Açık koleksiyondan yalnız bilinen token ile tek kayıt okunur.
    function evToken(id) { return id is string && id.matches('[a-f0-9]{32}'); }
    function evPublic(r,id) { return ebysPath(r,'ebysVerifications',id); }
    function evPrivate(r,id) { return ebysPath(r,'ebysVerificationTokens',id); }
    function evHead(r,id) { return ebysPath(r,'ebysDocuments',id); }
    function evEligible(h) {
      return h.state in ['closed','archived'] && ebysId(h.currentVersionId)
        && h.registrationNo.matches('EBYS-[A-Z0-9]{2,12}-[0-9]{6}-[A-F0-9]{32}');
    }
    function evIssuing(old,h,id) {
      return evEligible(old) && evToken(id) && old.get('verificationToken','') == ''
        && h.verificationToken == id && h.updatedAt == request.time && h.revision == old.revision+1
        && h.diff(old).affectedKeys().hasOnly(['verificationToken','revision','updatedAt']);
    }
    function evIssueHead(r,old,h) {
      let id = h.verificationToken;
      let token = getAfter(evPrivate(r,id)).data;
      return old.ownerUid == request.auth.uid && evIssuing(old,h,id)
        && token.documentId == old.id && token.versionId == old.currentVersionId && token.createdAt == request.time
        && getAfter(evPublic(r,id)).data.registrationNo == old.registrationNo;
    }
    function evProjection(r,id,p) {
      let token = getAfter(evPrivate(r,id)).data;
      let path = evHead(r,token.documentId);
      let head = get(path).data;
      let version = get(ebysPath(r,'ebysVersions',token.versionId)).data;
      let registration = get(ebysPath(r,'ebysRegistrationIds',head.registrationNo)).data;
      let summary = {'internal':'Kurum içi yazışma','incoming':'Kurum dışından gelen evrak','outgoing':'Kurum dışına giden evrak'}[head.kind];
      return evIssuing(head,getAfter(path).data,id) && head.ownerUid == request.auth.uid
        && token.createdAt == request.time && token.versionId == head.currentVersionId
        && version.documentId == head.id && version.ownerUid == head.ownerUid
        && version.contentDigest.matches('[a-f0-9]{64}') && registration.documentId == head.id
        && registration.ownerUid == head.ownerUid && registration.createdAt is timestamp
        && p == {'registrationNo':head.registrationNo,'registeredAt':registration.createdAt,'subjectSummary':summary,
                 'status':head.state == 'archived' ? 'archived' : 'valid','contentDigest':version.contentDigest};
    }
    function evReserve(r,id,t) {
      let path = evHead(r,t.documentId);
      let head = get(path).data;
      return ebysId(t.documentId) && evIssuing(head,getAfter(path).data,id)
        && head.ownerUid == request.auth.uid && !exists(evPublic(r,id))
        && t == {'documentId':head.id,'versionId':head.currentVersionId,'createdAt':request.time,'revokedAt':null,'revokedBy':''}
        && getAfter(evPublic(r,id)).data.registrationNo == head.registrationNo;
    }
    function evArchiveProjection(r,old) {
      let id = old.get('verificationToken','');
      return id == '' || (get(evPublic(r,id)).data.status == 'revoked'
        ? getAfter(evPublic(r,id)).data.status == 'revoked'
        : get(evPublic(r,id)).data.status == 'valid' && getAfter(evPublic(r,id)).data.status == 'archived');
    }
    function evPublicUpdate(r,id,old,d) {
      let token = get(evPrivate(r,id)).data;
      let path = evHead(r,token.documentId);
      return d.diff(old).affectedKeys().hasOnly(['status']) && (d.status == 'revoked'
        ? old.status in ['valid','archived'] && token.revokedAt == null
          && getAfter(evPrivate(r,id)).data.revokedAt == request.time
          && getAfter(evPrivate(r,id)).data.revokedBy == request.auth.uid
        : old.status == 'valid' && d.status == 'archived' && get(path).data.verificationToken == id
          && get(path).data.state == 'closed' && getAfter(path).data.state == 'archived');
    }
    match /{r}/ebysVerifications/items/{id} {
      allow get: if validRoot(r) && evToken(id) && (resource == null
        || resource.data.keys().hasOnly(['registrationNo','registeredAt','subjectSummary','status','contentDigest']));
      allow create: if validRoot(r) && signedIn() && evToken(id) && evProjection(r,id,request.resource.data);
      allow update: if validRoot(r) && isAdmin(r) && evPublicUpdate(r,id,resource.data,request.resource.data);
      allow list, delete: if false;
    }
    match /{r}/ebysVerificationTokens/items/{id} {
      allow read, delete: if false;
      allow create: if validRoot(r) && signedIn() && evToken(id) && evReserve(r,id,request.resource.data);
      allow update: if validRoot(r) && isAdmin(r) && resource.data.revokedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt','revokedBy'])
        && request.resource.data.revokedAt == request.time && request.resource.data.revokedBy == request.auth.uid
        && get(evPublic(r,id)).data.status in ['valid','archived'] && getAfter(evPublic(r,id)).data.status == 'revoked';
    }


    match /{r}/ebysDocuments/items/{id} {
      allow get: if validRoot(r) && member(r) && (!exists(ebysPath(r,'ebysDocuments',id)) || isAdmin(r) || resource.data.ownerUid == request.auth.uid || epAccess(r,resource.data.currentVersionId) || ejVersionAccess(r,resource.data.currentVersionId));
      allow list: if validRoot(r) && member(r) && (isAdmin(r) || resource.data.ownerUid == request.auth.uid);
      allow create: if ebysOwn(r, request.resource.data) && ebysHead(request.resource.data, id)
        && request.resource.data.state == 'draft' && request.resource.data.versionNo == 0 && request.resource.data.revision == 1 && request.resource.data.registrationNo == ''
        && request.resource.data.createdAt == request.time && ebysDraftHead(r, request.resource.data);
      allow update: if (ebysOwn(r, resource.data) && ebysHeadUpdate(r, resource.data, request.resource.data))
        || (validRoot(r) && member(r) && (request.resource.data.get('verificationToken','') != resource.data.get('verificationToken','')
          ? evIssueHead(r,resource.data,request.resource.data)
          : request.resource.data.state in ['closed','archived']
            ? ejCloseOrArchive(r,resource.data,request.resource.data)
            : epHeadTransition(r,resource.data,request.resource.data)));
      allow delete: if false;
    }
    function ebysDraftOk(r, id, d) {
      let h = getAfter(ebysPath(r,'ebysDocuments',id)).data;
      return d.keys().hasOnly(['id','documentId','ownerUid','revision','content','metadata','attachments','attachmentMode','updatedAt'])
        && d.id == id && d.documentId == id && ebysOwn(r,d) && h.ownerUid == d.ownerUid && h.revision == d.revision
        && h.state in ['draft','registered'] && ebysCommand(r,h,'saveDraft')
        && ebysText(d.content,40000,true) && ebysMetadata(d.metadata) && d.attachments == [] && d.attachmentMode == 'none' && d.updatedAt == request.time;
    }
    match /{r}/ebysDrafts/items/{id} {
      allow get: if validRoot(r) && member(r) && (!exists(ebysPath(r,'ebysDrafts',id)) || resource.data.ownerUid == request.auth.uid);
      allow list: if ebysOwn(r,resource.data);
      allow create: if ebysDraftOk(r,id,request.resource.data);
      allow update: if ebysOwn(r,resource.data) && request.resource.data.ownerUid == resource.data.ownerUid && ebysDraftOk(r,id,request.resource.data)
        && request.resource.data.revision == getAfter(ebysPath(r,'ebysDocuments',id)).data.revision;
      allow delete: if false;
    }
    function ebysVersionOk(r, id, d) {
      let h = getAfter(ebysPath(r,'ebysDocuments',d.documentId)).data;
      let draft = get(ebysPath(r,'ebysDrafts',d.documentId)).data;
      return d.keys().hasOnly(['id','processId','documentId','ownerUid','versionNo','schemaVersion','content','metadataSnapshot','attachments','attachmentMode','contentDigest','createdAt'])
        && ebysOwn(r,d) && ebysId(id) && d.id == id && d.processId == id && d.schemaVersion == 1 && d.versionNo == h.versionNo
        && h.currentVersionId == id && h.state == 'in_review' && h.ownerUid == d.ownerUid && ebysCommand(r,h,'freezeVersion')
        && d.content == draft.content && d.metadataSnapshot == draft.metadata && draft.ownerUid == d.ownerUid
        && d.contentDigest.matches('[a-f0-9]{64}') && d.attachments == [] && d.attachmentMode == 'none' && d.createdAt == request.time;
    }
    match /{r}/ebysVersions/items/{id} {
      allow read: if ebysOwn(r,resource.data) || (validRoot(r) && member(r) && epAccess(r,id));
      allow get: if validRoot(r) && member(r) && ejVersionAccess(r,id);
      allow create: if ebysVersionOk(r,id,request.resource.data);
      allow update, delete: if false;
    }
    match /{r}/ebysRegistrationIds/items/{number} {
      allow get: if validRoot(r) && member(r) && (!exists(ebysPath(r,'ebysRegistrationIds',number)) || isAdmin(r) || resource.data.ownerUid == request.auth.uid);
      allow list: if ebysOwn(r,resource.data);
      allow create: if ebysOwn(r,request.resource.data) && number.matches('EBYS-[A-Z0-9]{2,12}-[0-9]{6}-[A-F0-9]{32}')
        && request.resource.data.keys().hasOnly(['id','documentId','ownerUid','operationId','createdAt'])
        && request.resource.data.id == number && request.resource.data.createdAt == request.time
        && int(number.split('-')[2]) == (request.time.year() % 100) * 10000 + request.time.month() * 100 + request.time.day()
        && number.split('-')[1] == getAfter(ebysPath(r,'ebysDocuments',request.resource.data.documentId)).data.organizationCode
        && getAfter(ebysPath(r,'ebysDocuments',request.resource.data.documentId)).data.registrationNo == number
        && getAfter(ebysPath(r,'ebysDocuments',request.resource.data.documentId)).data.lastOperationId == request.resource.data.operationId;
      allow update, delete: if false;
    }
    function ebysLogOk(r,id,d) {
      let h = getAfter(ebysPath(r,'ebysDocuments',d.documentId)).data;
      return ebysOwn(r,d) && ebysId(id) && d.id == id && d.ownerUid == h.ownerUid
        && h.lastOperationId == id && h.revision == d.revision && d.createdAt == request.time;
    }
    match /{r}/ebysOperations/items/{id} {
      allow get: if validRoot(r) && member(r) && (!exists(ebysPath(r,'ebysOperations',id)) || resource.data.ownerUid == request.auth.uid);
      allow list: if ebysOwn(r,resource.data);
      allow create: if ebysLogOk(r,id,request.resource.data)
        && request.resource.data.keys().hasOnly(['id','documentId','ownerUid','command','payloadDigest','result','revision','createdAt'])
        && request.resource.data.command in ['saveDraft','freezeVersion','registerDocument'] && request.resource.data.payloadDigest.matches('[a-f0-9]{64}')
        && request.resource.data.result.documentId == request.resource.data.documentId && request.resource.data.result.revision == request.resource.data.revision
        && getAfter(ebysPath(r,'ebysEvents',id)).data.type == request.resource.data.command;
      allow update, delete: if false;
    }
    match /{r}/ebysEvents/items/{id} {
      allow read: if ebysOwn(r,resource.data);
      allow create: if ebysLogOk(r,id,request.resource.data)
        && request.resource.data.keys().hasOnly(['id','documentId','ownerUid','operationId','type','revision','createdAt'])
        && request.resource.data.operationId == id && request.resource.data.type == getAfter(ebysPath(r,'ebysOperations',id)).data.command;
      allow update, delete: if false;
    }
    function financeSource(r,d,p) {
      let config = ebysPath(r,'system_config','ebys_rates');
      let a = p.items;
      return d.exchangeRateSource == 'TRY'
        ? d.exchangeRate == {'TRY':1,'USD':1,'EUR':1} && a[0].currency == 'TRY' && (a.size()<2 || a[1].currency == 'TRY') && (a.size()<3 || a[2].currency == 'TRY')
        : d.exchangeRate == get(config).data.rates && d.exchangeRateDate == get(config).data.date && d.exchangeRateSource == get(config).data.source;
    }
    match /{r}/purchaseFinance/items/{docId} {
      allow get: if validRoot(r) && member(r) && (!exists(ebysPath(r,'purchaseFinance',docId)) || isAdmin(r)
        || lpRead(r,docId,get(ebysPath(r,'purchaseOrders',docId)).data,request.auth.uid));
      allow list: if validRoot(r) && isAdmin(r);
      allow create: if validRoot(r) && member(r) && poFinanceCreate(r,docId,request.resource.data);
      allow update,delete: if false;
    }
    function poFinanceCreate(r,docId,d) {
      let path = ebysPath(r,'purchaseOrders',docId);
      let old = get(path).data;
      let next = getAfter(path).data;
      return next.id == docId && old.workflow.get('currentStep',-1) == 0 && old.workflow.steps[0].status == 'pending'
        && next.workflow.steps[0].status == 'approved' && d == poFxSnapshot(next)
        && poFxFieldsOk(d) && d.exchangeRate.USD > 0 && d.exchangeRate.EUR > 0 && financeSource(r,d,next);
    }
    function lpHistory(a,i,who) { return a.size()>i && a[i].get('userUid','') == who && a[i].get('status','') in ['approved','rejected']; }
    function lpDecided(a,who) {
      return lpHistory(a,0,who) || lpHistory(a,1,who) || lpHistory(a,2,who) || lpHistory(a,3,who) || lpHistory(a,4,who)
        || lpHistory(a,5,who) || lpHistory(a,6,who) || lpHistory(a,7,who) || lpHistory(a,8,who) || lpHistory(a,9,who);
    }
    function poHistoryId(docId,wf) { return docId+'__'+string(wf.get('history',[]).size()); }
    function poHistoryPath(r,docId,wf) { return ebysPath(r,'purchaseHistory',poHistoryId(docId,wf)); }
    function poWithdrawTransition(old,d) {
      return d.get('durum','') == 'Taslak' && d.get('workflow',{}).get('started',true) == false
        && old.get('workflow',{}).get('started',false) == true;
    }
    function poKeepHistory(r,docId,old,d) {
      let steps = old.get('workflow',{}).get('steps',[]);
      return !poWithdrawTransition(old,d) || steps.size() == 0 || !(steps[0].get('status','') in ['approved','rejected'])
        || poHistoryWritten(r,docId,old,d.workflow);
    }
    function poHistoryWritten(r,docId,old,wf) {
      let path = poHistoryPath(r,docId,wf);
      return !exists(path) && getAfter(path).data.snapshot == old;
    }
    function lpFrozenRead(r,docId,d,wf,who) {
      let path = poHistoryPath(r,docId,wf);
      return exists(path) && lpFrozenMatch(d,get(path).data.snapshot,who);
    }
    function lpFrozenMatch(d,frozen,who) {
      return lpDecided(frozen.workflow.steps,who) && d.diff(frozen).affectedKeys().hasOnly(['id','workflow','durum','akis']);
    }
    function lpRead(r,docId,d,who) {
      let wf = d.get('workflow',{});
      let a = wf.get('steps',[]);
      let i = wf.get('currentStep',-1);
      return d.get('createdByUid','') == who
        || (wf.get('started',false) == true && wf.get('finished',false) != true && i is int && i>=0 && i<a.size() && a[i].get('userUid','') == who)
        || lpDecided(a,who)
        || (d.get('durum','') == 'Taslak' && wf.get('started',true) == false && lpFrozenRead(r,docId,d,wf,who));
    }
    match /{r}/purchaseHistory/items/{id} {
      allow get: if validRoot(r) && member(r) && (isAdmin(r) || resource.data.snapshot.get('createdByUid','') == request.auth.uid
        || lpDecided(resource.data.snapshot.workflow.steps,request.auth.uid));
      allow create: if validRoot(r) && member(r) && poHistoryCreate(r,id,request.resource.data);
      allow update,delete,list: if false;
    }
    function poHistoryCreate(r,id,d) {
      let path = ebysPath(r,'purchaseOrders',d.purchaseId);
      let old = get(path).data;
      let next = getAfter(path).data;
      return d.keys().hasOnly(['purchaseId','snapshot','createdAt']) && d.createdAt == request.time
        && (isAdmin(r) || old.createdByUid == request.auth.uid) && d.snapshot == old
        && poWithdrawTransition(old,next) && next.workflow.steps.size() == 0
        && next.workflow.history.size() == old.workflow.get('history',[]).size()+1
        && next.workflow.history[next.workflow.history.size()-1].action == 'withdraw'
        && id == poHistoryId(d.purchaseId,next.workflow);
    }
    function lpProofRead(r,d,who) {
      return lpRead(r,d.purchaseId,get(ebysPath(r,'purchaseOrders',d.purchaseId)).data,who);
    }
    function lpHistoryProof(r,d) {
      let archive = getAfter(ebysPath(r,'purchaseHistory',d.historyId)).data;
      return archive.purchaseId == d.purchaseId && lpDecided(archive.snapshot.workflow.steps,d.assigneeUid)
        && (isAdmin(r) || archive.snapshot.get('createdByUid','') == request.auth.uid || request.auth.uid == d.assigneeUid);
    }
    match /{r}/purchaseAccess/items/{id} {
      allow get: if validRoot(r) && member(r) && (!exists(ebysPath(r,'purchaseAccess',id)) || isAdmin(r) || resource.data.assigneeUid == request.auth.uid || lpProofRead(r,resource.data,request.auth.uid));
      allow list: if validRoot(r) && member(r) && (isAdmin(r) || resource.data.assigneeUid == request.auth.uid);
      allow create: if validRoot(r) && member(r) && request.resource.data.keys().hasOnly(['purchaseId','assigneeUid','createdAt','updatedAt','historyId'])
        && id == request.resource.data.purchaseId+'__'+request.resource.data.assigneeUid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && (request.resource.data.get('historyId','') != '' ? lpHistoryProof(r,request.resource.data)
          : (isAdmin(r) || lpProofRead(r,request.resource.data,request.auth.uid)) && lpProofRead(r,request.resource.data,request.resource.data.assigneeUid));
      allow update: if validRoot(r) && member(r) && request.resource.data.updatedAt == request.time
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          ? (isAdmin(r) || lpProofRead(r,resource.data,request.auth.uid)) && lpProofRead(r,resource.data,resource.data.assigneeUid)
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','historyId']) && lpHistoryProof(r,request.resource.data));
      allow delete: if false;
    }
    // Aşama 6 · Her sabit sürüme tek icra işi. Onay rotası ve imzacı görevleri ayrı kalır.
    function ej(r,id) { return ebysPath(r,'ebysExecutionJobs',id); }
    function ejEventId(id,revision) { return id+'__'+string(revision); }
    function ejActive(d) { return d.state in ['pending_acceptance','in_progress']; }
    function ejVersionAccess(r,id) {
      let job = get(ej(r,id)).data;
      return job.assigneeUid == request.auth.uid && ejActive(job);
    }
    function ejTarget(r,d) {
      let p = get(ebysPath(r,'personel',d.personnelId)).data;
      return d.assigneeUid is string && p.uid == d.assigneeUid && p.unitId == d.unitId && p.get('active',true) == true
        && get(ebysPath(r,'units',d.unitId)).data.get('active',true) == true
        && get(ebysPath(r,'staffAccounts',d.assigneeUid)).data.personelId == d.personnelId
        && get(ebysPath(r,'staffAccounts',d.assigneeUid)).data.pri == p.pri
        && d.dueHours is int && d.dueHours >= 1 && d.dueHours <= 720;
    }
    function ejDue(d) {
      return d.dueAt is timestamp && d.dueAt > request.time
        && d.dueAt <= request.time + duration.value(d.dueHours,'h') + duration.value(5,'m')
        && d.dueAt >= request.time + duration.value(d.dueHours,'h') - duration.value(5,'m');
    }
    function ejPolicyPath(r,kind,unitId) {
      return ebysPath(r,'ebysExecutionPolicies',unitId == '' ? kind : kind+'__'+unitId);
    }
    function ejPolicy(r,head,d) {
      let specific = ejPolicyPath(r,head.kind,head.unitId);
      let key = exists(specific) ? head.kind+'__'+head.unitId : head.kind;
      let p = get(ebysPath(r,'ebysExecutionPolicies',key)).data;
      return d.policyId == key && d.sourceUnitId == head.unitId && p.kind == head.kind
        && d.unitId == p.unitId && d.personnelId == p.personnelId && d.assigneeUid == p.assigneeUid && d.dueHours == p.dueHours;
    }
    function ejCreate(r,id,d) {
      let before = get(ep(r,id)).data;
      let process = getAfter(ep(r,id)).data;
      let head = getAfter(ebysPath(r,'ebysDocuments',process.documentId)).data;
      return d.keys().hasOnly(['id','processId','versionId','documentId','ownerUid','kind','unitId','personnelId','assigneeUid','dueHours','sourceUnitId','policyId',
                               'dueAt','originalDueAt','returnedAt','state','revision','lastAction','lastActorUid','note','evidenceRef','stockOperationId','createdAt','updatedAt'])
        && before.state == 'active' && before.activeAssigneeUid == request.auth.uid && process.state == 'completed'
        && process.revision == before.revision+1 && process.updatedAt == request.time
        && head.state == 'internally_approved' && head.currentVersionId == id
        && d.id == id && d.processId == id && d.versionId == id && d.documentId == process.documentId
        && d.ownerUid == process.ownerUid && d.kind == head.kind && d.state == 'pending_acceptance' && d.revision == 1
        && d.originalDueAt == d.dueAt && d.returnedAt == null && ejPolicy(r,head,d)
        && d.lastAction == 'assign' && d.lastActorUid == request.auth.uid && d.createdAt == request.time && d.updatedAt == request.time
        && d.note == '' && d.evidenceRef == '' && d.stockOperationId == '' && ejTarget(r,d) && ejDue(d);
    }
    function ejHeadChanged(old,d,state) {
      return d.state == state && d.diff(old).affectedKeys().hasOnly(['state','revision','updatedAt'])
        && d.revision == old.revision+1 && d.updatedAt == request.time;
    }
    function ejCloseOrArchive(r,old,d) {
      let job = get(ej(r,old.currentVersionId)).data;
      return job.documentId == old.id && (d.state == 'closed'
        ? old.state == 'internally_approved' && job.state == 'in_progress' && job.assigneeUid == request.auth.uid
          && getAfter(ej(r,old.currentVersionId)).data.state == 'completed' && ejHeadChanged(old,d,'closed')
        : old.state == 'closed' && job.state == 'completed' && isAdmin(r) && ejHeadChanged(old,d,'archived')
          && getAfter(ebysPath(r,'ebysExecutionEvents',job.id+'__archive')).data.createdAt == request.time
          && evArchiveProjection(r,old));
    }
    function ejEvidence(r,d) {
      return ebysText(d.note,1000,true) && ebysText(d.evidenceRef,240,true)
        && (d.stockOperationId == '' || (d.stockOperationId is string && d.stockOperationId.matches('[A-Za-z0-9_-]{8,80}')
          && exists(ebysPath(r,'stockOperations',d.stockOperationId))
          && get(ebysPath(r,'ebysExecutionStockLinks',d.stockOperationId)).data.processId == d.id));
    }
    function ejCompleted(r,d) {
      let headPath = ebysPath(r,'ebysDocuments',d.documentId);
      let notification = getAfter(ebysPath(r,'ebysNotifications',d.id)).data;
      return ejHeadChanged(get(headPath).data,getAfter(headPath).data,'closed')
        && notification.recipientUid == d.ownerUid && notification.createdAt == request.time;
    }
    function ejUpdate(r,old,d) {
      let changes = d.diff(old).affectedKeys();
      let e = getAfter(ebysPath(r,'ebysExecutionEvents',ejEventId(old.id,d.revision))).data;
      return old.state != 'completed' && d.revision == old.revision+1 && d.updatedAt == request.time
        && d.lastActorUid == request.auth.uid && e.revision == d.revision && e.createdAt == request.time
        && d.returnedAt == (d.state == 'returned' ? request.time : null)
        && (d.lastAction == 'reassign'
          ? isAdmin(r) && d.state == 'pending_acceptance' && (old.state == 'returned' || d.assigneeUid != old.assigneeUid)
            && changes.hasOnly(['unitId','personnelId','assigneeUid','dueHours','dueAt','state','revision','updatedAt','lastAction','lastActorUid','note','returnedAt'])
            && ebysText(d.note,1000,true) && ejTarget(r,d) && ejDue(d)
          : old.assigneeUid == request.auth.uid
            && changes.hasOnly(['state','revision','updatedAt','lastAction','lastActorUid','note','evidenceRef','stockOperationId','returnedAt'])
            && (d.lastAction == 'accept' && old.state == 'pending_acceptance' && d.state == 'in_progress'
                && d.note == '' && d.evidenceRef == '' && d.stockOperationId == ''
              || d.lastAction == 'return' && old.state == 'in_progress' && d.state == 'returned'
                && ebysText(d.note,1000,true) && d.evidenceRef == '' && d.stockOperationId == ''
              || d.lastAction == 'complete' && old.state == 'in_progress' && d.state == 'completed'
                && ejEvidence(r,d) && ejCompleted(r,d)));
    }
    function ejPolicyWrite(r,id,d) {
      return d.kind in ['incoming','outgoing','internal'] && definitionKey(d.sourceUnitId) && d.updatedAt == request.time
        && id == (d.sourceUnitId == '' ? d.kind : d.kind+'__'+d.sourceUnitId)
        && (d.sourceUnitId == '' || get(unitPath(r,d.sourceUnitId)).data.get('active',true) == true)
        && d.keys().hasOnly(['kind','unitId','personnelId','assigneeUid','dueHours','sourceUnitId','updatedAt'])
        && ejTarget(r,d);
    }
    match /{r}/ebysExecutionPolicies/items/{id} {
      allow get: if validRoot(r) && member(r);
      allow create, update: if validRoot(r) && isAdmin(r) && ejPolicyWrite(r,id,request.resource.data);
      allow list, delete: if false;
    }
    function ejStockLink(r,id,d) {
      return id.matches('[A-Za-z0-9_-]{8,80}') && ebysId(d.processId)
        && d.operationId == id && d.actorUid == request.auth.uid && d.createdAt == request.time && ebysText(d.note,240,true)
        && d.keys().hasOnly(['operationId','processId','actorUid','note','createdAt'])
        && ejActive(get(ej(r,d.processId)).data) && exists(ebysPath(r,'stockOperations',id));
    }
    match /{r}/ebysExecutionStockLinks/items/{id} {
      allow get: if validRoot(r) && isAdmin(r);
      allow create: if validRoot(r) && isAdmin(r) && ejStockLink(r,id,request.resource.data);
      allow list, update, delete: if false;
    }
    match /{r}/ebysExecutionJobs/items/{id} {
      allow get, list: if validRoot(r) && member(r)
        && (resource.data.assigneeUid == request.auth.uid || resource.data.ownerUid == request.auth.uid || isAdmin(r));
      // Aynı yazımdaki süreç geçişi üyelik ve aktör yetkisini doğrular.
      allow create: if validRoot(r) && signedIn() && ebysId(id) && ejCreate(r,id,request.resource.data);
      allow update: if validRoot(r) && member(r) && ejUpdate(r,resource.data,request.resource.data);
      allow delete: if false;
    }
    function ejEventOk(r,id,e) {
      let old = get(ej(r,e.processId)).data;
      let d = getAfter(ej(r,e.processId)).data;
      return e == {'id':id,'processId':d.id,'ownerUid':d.ownerUid,'revision':d.revision,'from':old.state,'to':d.state,
        'action':d.lastAction,'actorUid':request.auth.uid,'previousAssigneeUid':old.assigneeUid,'assigneeUid':d.assigneeUid,
        'note':d.note,'returnedAt':old.get('returnedAt',null),'createdAt':request.time}
        && id == ejEventId(d.id,d.revision) && d.revision == old.revision+1 && d.updatedAt == request.time;
    }
    function ejArchiveEvent(r,id,e) {
      let job = get(ej(r,e.processId)).data;
      let path = evHead(r,job.documentId);
      let old = get(path).data;
      let next = getAfter(path).data;
      return job.state == 'completed' && old.currentVersionId == job.id && old.state == 'closed'
        && ejHeadChanged(old,next,'archived') && id == job.id+'__archive'
        && e == {'id':id,'processId':job.id,'ownerUid':job.ownerUid,'revision':job.revision+1,
                 'documentRevision':next.revision,'from':'closed','to':'archived','action':'archive',
                 'actorUid':request.auth.uid,'createdAt':request.time};
    }
    match /{r}/ebysExecutionEvents/items/{id} {
      allow read: if validRoot(r) && isAdmin(r);
      allow create: if validRoot(r) && (request.resource.data.action == 'archive'
        ? isAdmin(r) && ejArchiveEvent(r,id,request.resource.data)
        : member(r) && ejEventOk(r,id,request.resource.data));
      allow update, delete: if false;
    }
    function ejNotificationOk(r,id,n) {
      let old = get(ej(r,id)).data;
      let job = getAfter(ej(r,id)).data;
      return old.state == 'in_progress' && old.assigneeUid == request.auth.uid && job.state == 'completed'
        && job.revision == old.revision+1 && job.updatedAt == request.time
        && n == {'id':id,'processId':id,'documentId':job.documentId,'recipientUid':job.ownerUid,'eventId':ejEventId(id,job.revision),
                 'type':'execution_closed','emailState':'deferred','readAt':null,'createdAt':request.time};
    }
    match /{r}/ebysNotifications/items/{id} {
      allow get, list: if validRoot(r) && member(r) && resource.data.recipientUid == request.auth.uid;
      allow create: if validRoot(r) && member(r) && ejNotificationOk(r,id,request.resource.data);
      allow update: if validRoot(r) && member(r) && resource.data.recipientUid == request.auth.uid && resource.data.readAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
      allow delete: if false;
    }


    // Aşama 5: sahiplik ACL dizisi yerine doğrulanmış deterministik görev/karar.
    function ep(r,id) { return ebysPath(r,'ebysProcesses',id); }
    function epHeadTransition(r,old,d) {
      let p = getAfter(ep(r,old.currentVersionId)).data;
      return d.diff(old).affectedKeys().hasOnly(['state','revision','updatedAt']) && d.revision == old.revision+1 && d.updatedAt == request.time
        && get(ep(r,old.currentVersionId)).data.state == 'active' && p.revision == get(ep(r,old.currentVersionId)).data.revision+1
        && p.documentId == old.id && p.state in ['completed','returned','rejected','withdrawn']
        && d.state == (p.state == 'completed' ? 'internally_approved' : p.state);
    }
    function et(r,id,who) { return ebysPath(r,'ebysTasks',id+'__'+who); }
    function epLive(p,t) { return p.state == 'active' && t.state == 'active' && p.activeAssigneeUid == t.assigneeUid
      && p.currentStep == t.stepIndex && request.time >= t.validFrom && request.time < t.validUntil; }
    function epAccess(r,id) {
      let path = et(r,id,request.auth.uid);
      return exists(path) && (get(path).data.hasDecision == true || epLive(get(ep(r,id)).data,get(path).data));
    }
    function epCommand(r,p) {
      let path = ebysPath(r,'ebysProcessOperations',p.lastOperationId);
      let op = getAfter(path).data;
      return !exists(path) && op.processId == p.id && op.actorUid == request.auth.uid && op.command == p.lastCommand && op.result.revision == p.revision;
    }
    function epStep(s,i,owner) {
      return s.stepId == 'step-'+string(i) && s.personnelId is string && s.assigneeUid is string && s.assigneeUid != owner
        && s.kind in ['paraf','approval','consent'] && s.dueHours is int && s.dueHours >= 1 && s.dueHours <= 720;
    }
    // Rota immutable kalır. Güvenlik koşulları her adım AKTİF yapılırken etWrite içinde
    // doğrulanır; gelecekteki altı adımın aynı istekte tekrar açılması gerekmez.
    function epRoute(a) { return a is list && a.size() >= 1 && a.size() <= 6; }
    function epTemplate(r,p) {
      let path = ebysPath(r,'ebysRouteTemplates',p.templateId);
      return p.templateId == '' ? p.templateRevision == 0
        : ebysId(p.templateId) && p.templateRevision == get(path).data.revision && p.routeSnapshot == get(path).data.routeSnapshot;
    }
    match /{r}/ebysRouteTemplates/items/{id} {
      allow read: if validRoot(r) && member(r);
      allow create: if validRoot(r) && isAdmin(r) && ebysId(id) && request.resource.data.id == id
        && request.resource.data.keys().hasOnly(['id','ownerUid','name','revision','routeSnapshot','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid && ebysText(request.resource.data.name,120,true)
        && request.resource.data.revision == 1 && epRoute(request.resource.data.routeSnapshot) && request.resource.data.createdAt == request.time;
      allow update,delete: if false;
    }
    function epBase(p,id) {
      return ebysId(id) && p.id == id && p.versionId == id && p.keys().hasOnly(['id','documentId','versionId','ownerUid','routeSnapshot','templateId','templateRevision','currentStep','activeAssigneeUid','state','revision','lastOperationId','lastCommand','lastResult','lastReason','createdAt','updatedAt'])
        && p.updatedAt == request.time && p.revision is int && ebysId(p.lastOperationId) && ebysText(p.lastReason,1000,false);
    }
    function epActivation(r,p) {
      let path = et(r,p.id,p.activeAssigneeUid);
      let t = getAfter(path).data;
      return t.state == 'active' && t.stepIndex == p.currentStep && t.updatedAt == request.time
        && t.revision == (exists(path) ? get(path).data.revision+1 : 1);
    }
    function epClosedTask(r,p,next) {
      let path = et(r,p.id,p.activeAssigneeUid);
      let t = getAfter(path).data;
      return t.revision == get(path).data.revision+1 && t.updatedAt == request.time
        && (next.state == 'active' && next.activeAssigneeUid == p.activeAssigneeUid ? t.state == 'active' : t.state != 'active');
    }
    function epTerminalHead(r,p) {
      let path = ebysPath(r,'ebysDocuments',p.documentId);
      let after = getAfter(path).data;
      return after.currentVersionId == p.id && after.revision == get(path).data.revision+1
        && after.state == (p.state == 'completed' ? 'internally_approved' : p.state)
        && (p.state != 'completed' || getAfter(ej(r,p.id)).data.createdAt == request.time);
    }
    function epUpdate(r,p,n) {
      let t = get(et(r,p.id,p.activeAssigneeUid)).data;
      return epBase(n,p.id) && epCommand(r,n) && p.state == 'active'
        && n.diff(p).affectedKeys().hasOnly(['currentStep','activeAssigneeUid','state','revision','lastOperationId','lastCommand','lastResult','lastReason','updatedAt'])
        && n.revision == p.revision+1 && epClosedTask(r,p,n)
        && (n.state == 'active' || epTerminalHead(r,n))
        && (n.lastCommand == 'decide' && p.activeAssigneeUid == request.auth.uid && epLive(p,t)
          && n.lastResult in ['approved','rejected','returned'] && (n.lastResult == 'approved' || n.lastReason.trim().size()>0)
          && (n.lastResult == 'approved' && p.currentStep+1 < p.routeSnapshot.size()
            ? n.state == 'active' && n.currentStep == p.currentStep+1 && n.activeAssigneeUid == p.routeSnapshot[n.currentStep].assigneeUid && epActivation(r,n)
            : n.state == (n.lastResult == 'approved' ? 'completed' : n.lastResult) && n.currentStep == p.currentStep && n.activeAssigneeUid == '')
        || n.lastCommand == 'withdraw' && n.lastResult == 'withdrawn' && p.ownerUid == request.auth.uid && n.state == 'withdrawn' && n.currentStep == p.currentStep && n.activeAssigneeUid == '' && n.lastReason.trim().size()>0
        || n.lastCommand == 'delegate' && n.lastResult == 'delegated' && n.lastReason.trim().size()>0 && isAdmin(r) && n.state == 'active' && n.currentStep == p.currentStep && n.activeAssigneeUid != p.activeAssigneeUid && n.activeAssigneeUid != p.ownerUid && epActivation(r,n));
    }
    match /{r}/ebysProcesses/items/{id} {
      allow get: if validRoot(r) && member(r) && (!exists(ep(r,id)) || isAdmin(r) || resource.data.ownerUid == request.auth.uid || resource.data.activeAssigneeUid == request.auth.uid || epAccess(r,id));
      allow list: if validRoot(r) && member(r) && (isAdmin(r) || resource.data.ownerUid == request.auth.uid);
      allow create: if validRoot(r) && member(r) && epBase(request.resource.data,id) && epRoute(request.resource.data.routeSnapshot)
        && request.resource.data.ownerUid == request.auth.uid && epTemplate(r,request.resource.data) && request.resource.data.currentStep == 0 && request.resource.data.state == 'active'
        && request.resource.data.activeAssigneeUid == request.resource.data.routeSnapshot[0].assigneeUid && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time && request.resource.data.lastCommand == 'start'
        && get(ebysPath(r,'ebysVersions',id)).data.documentId == request.resource.data.documentId
        && get(ebysPath(r,'ebysVersions',id)).data.ownerUid == request.auth.uid
        && get(ebysPath(r,'ebysDocuments',request.resource.data.documentId)).data.currentVersionId == id
        && epCommand(r,request.resource.data) && epActivation(r,request.resource.data);
      allow update: if validRoot(r) && member(r) && epUpdate(r,resource.data,request.resource.data);
      allow delete: if false;
    }
    function etDecisions(r,old,d,p,before) {
      let a = old.get('decisionsByStep',{});
      let b = d.decisionsByStep;
      let key = string(before.get('currentStep',-1));
      let adds = p.lastCommand == 'decide' && before.get('activeAssigneeUid','') == d.assigneeUid && p.lastResult in ['approved','rejected'];
      return b is map && d.hasDecision == (b.size()>0) && (adds
        ? !a.keys().hasAny([key]) && b.diff(a).affectedKeys().hasOnly([key]) && b.size() == a.size()+1
          && b[key] == {'stepId':old.stepId,'versionId':p.id,'kind':old.kind,'actorUid':request.auth.uid,'principalUid':old.principalUid,'result':p.lastResult,'reason':p.lastReason,'decidedAt':request.time}
        : b == a);
    }
    function etPerson(r,pid,who) {
      let person = get(ebysPath(r,'personel',pid)).data;
      let account = get(ebysPath(r,'staffAccounts',who)).data;
      return person.get('active',true) == true && person.uid == who && account.personelId == pid && account.pri == person.pri;
    }
    function etWrite(r,id,d,old) {
      let p = getAfter(ep(r,d.processId)).data;
      let before = exists(ep(r,d.processId)) ? get(ep(r,d.processId)).data : {};
      let step = p.routeSnapshot[p.currentStep];
      return id == p.id+'__'+d.assigneeUid && d.id == id && d.processId == p.id && d.versionId == p.id && d.documentId == p.documentId && d.ownerUid == p.ownerUid
        && d.keys().hasOnly(['id','processId','versionId','documentId','ownerUid','assigneeUid','principalUid','stepIndex','stepId','kind','state','decisionsByStep','hasDecision','revision','createdAt','updatedAt','validFrom','validUntil','dueAt'])
        && d.revision == old.get('revision',0)+1 && d.updatedAt == request.time && d.createdAt == old.get('createdAt',request.time)
        && p.revision == before.get('revision',0)+1 && p.updatedAt == request.time && etDecisions(r,old,d,p,before)
        && (p.state == 'active' && p.activeAssigneeUid == d.assigneeUid
          ? epStep(step,p.currentStep,p.ownerUid) && d.state == 'active' && d.stepIndex == p.currentStep && d.stepId == step.stepId && d.kind == step.kind && d.principalUid == step.assigneeUid
            && d.validFrom == request.time && d.validUntil > request.time && d.validUntil <= request.time+duration.value(90,'d')
            && d.dueAt is timestamp && d.assigneeUid != p.ownerUid
            && (p.lastCommand == 'delegate' ? isAdmin(r) : d.assigneeUid == step.assigneeUid)
            && etPerson(r,p.lastCommand == 'delegate' ? getAfter(ebysPath(r,'ebysProcessOperations',p.lastOperationId)).data.result.personnelId : step.personnelId,d.assigneeUid)
          : before.get('activeAssigneeUid','') == d.assigneeUid
            && d.diff(old).affectedKeys().hasOnly(['decisionsByStep','hasDecision','state','revision','updatedAt'])
            && d.state == (p.lastCommand == 'withdraw' ? 'cancelled' : p.lastCommand == 'delegate' ? 'delegated' : 'closed'));
    }
    match /{r}/ebysTasks/items/{id} {
      allow get: if validRoot(r) && member(r) && (!exists(ebysPath(r,'ebysTasks',id)) || isAdmin(r) || resource.data.ownerUid == request.auth.uid || resource.data.assigneeUid == request.auth.uid || epAccess(r,resource.data.processId));
      allow list: if validRoot(r) && member(r) && (resource.data.assigneeUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow create: if validRoot(r) && member(r) && etWrite(r,id,request.resource.data,{});
      allow update: if validRoot(r) && member(r) && etWrite(r,id,request.resource.data,resource.data);
      allow delete: if false;
    }
    match /{r}/ebysProcessOperations/items/{id} {
      allow get: if validRoot(r) && member(r) && (!exists(ebysPath(r,'ebysProcessOperations',id)) || resource.data.actorUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow list: if validRoot(r) && member(r) && (resource.data.actorUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow create: if validRoot(r) && member(r) && ebysId(id) && request.resource.data.id == id && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id','processId','actorUid','ownerUid','command','payloadDigest','result','createdAt'])
        && request.resource.data.ownerUid == getAfter(ep(r,request.resource.data.processId)).data.ownerUid
        && request.resource.data.payloadDigest.matches('[a-f0-9]{64}') && request.resource.data.createdAt == request.time
        && getAfter(ep(r,request.resource.data.processId)).data.lastOperationId == id && request.resource.data.result.processId == request.resource.data.processId
        && request.resource.data.command == getAfter(ep(r,request.resource.data.processId)).data.lastCommand
        && request.resource.data.result.revision == getAfter(ep(r,request.resource.data.processId)).data.revision
        && getAfter(ebysPath(r,'ebysProcessEvents',id)).data.command == request.resource.data.command;
      allow update,delete: if false;
    }
    match /{r}/ebysProcessEvents/items/{id} {
      allow read: if validRoot(r) && member(r) && (resource.data.actorUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow create: if validRoot(r) && member(r) && request.resource.data.keys().hasOnly(['id','processId','actorUid','ownerUid','command','revision','reason','createdAt'])
        && request.resource.data.ownerUid == getAfter(ep(r,request.resource.data.processId)).data.ownerUid
        && request.resource.data.id == id && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.command == getAfter(ebysPath(r,'ebysProcessOperations',id)).data.command
        && getAfter(ep(r,request.resource.data.processId)).data.lastOperationId == id
        && request.resource.data.reason == getAfter(ep(r,request.resource.data.processId)).data.lastReason
        && request.resource.data.revision == getAfter(ep(r,request.resource.data.processId)).data.revision;
      allow update,delete: if false;
    }
    // V1 arşiv kilidi. Kök /system_config bloğu kaldırıldı (uygulama ${root}/system_config/items kullanıyor; RULE-04).
    match /inventory/{document=**} {
      allow read, write: if false;
    }
  }
}
